From 6d15863dcf31be05d35e586911cc251ac4eb1cc7 Mon Sep 17 00:00:00 2001
From: Your Name <you@example.com>
Date: Wed, 11 Nov 2026 14:01:13 +0100
Subject: [PATCH] accept a null pointer in the quake3 game trap checks

OpenArena's qagame.qvm calls G_REAL_TIME with a null qtime at several
sites (OP_CONST 0; OP_ARG 8; OP_CONST -42; OP_CALL), which is legal:
ioquake3's VM_ArgPtr(0) answers NULL, its traps do not validate at all,
and Com_RealTime(NULL) returns time(NULL) without touching the struct.
FTE's Q3VM_GetRealtime already has the same if (qtime) guard, but
VALIDATEPOINTER rejects the null before the trap body runs, so the game
dies with "Call to game trap 41 passes invalid pointer" right after the
UI VM starts. Let the null through and keep the range check for
everything else, which is what ioquake3 effectively does.
---
 plugins/quake3/svq3_game.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/plugins/quake3/svq3_game.c b/plugins/quake3/svq3_game.c
index db9457d..2bbaba1 100644
--- a/plugins/quake3/svq3_game.c
+++ b/plugins/quake3/svq3_game.c
@@ -835,7 +835,7 @@ static qboolean SV_InPVS(vec3_t p1, vec3_t p2)
 	}
 }
 
-#define VALIDATEPOINTER(o,l) if ((int)o + l >= mask || VM_POINTER(o) < offset) plugfuncs->EndGame("Call to game trap %u passes invalid pointer\n", (unsigned int)fn);	//out of bounds.
+#define VALIDATEPOINTER(o,l) if (o && ((int)o + l >= mask || VM_POINTER(o) < offset)) plugfuncs->EndGame("Call to game trap %u passes invalid pointer\n", (unsigned int)fn);	//out of bounds. 0 is accepted: ioquake3's VM_ArgPtr(0) answers NULL and its traps take that as "no pointer" (G_REAL_TIME's qtime in particular).
 static qintptr_t Q3G_SystemCalls(void *offset, quintptr_t mask, qintptr_t fn, const qintptr_t *arg)
 {
 	int ret = 0;
