+// Picks an audio sink description that works on this system.
+// autaudiosink/pulsedsink are not present in the Watermelon Wine rootfs,
+// so fall back to alsasink (HDMI playback) with 48 kHz/S16LE forced
+// (the playback_hdmi device rejects the 44.1 kHz AAC of DASH mp4 streams).
+static QString audioSinkDescription()
+{
+    const char *candidates[] = {"autaudiosink", "pulsedsink", nullptr};
+    for (int i = 0; candidates[i]; ++i) {
+        GstElementFactory *factory = gst_element_factory_find(candidates[i]);
+        if (factory) {
+            gst_object_unref(factory);
+            return QString(candidates[i]);
+        }
+    }
+    return QStringLiteral(
+        "audioconvert ! audioresample ! "
+        "capsfilter caps=\"audio/x-raw,rate=(uint)48000,channels=(uint)2,format=(string)S16LE\" "
+        "! alsasink device=playback_hdmi");
+}
