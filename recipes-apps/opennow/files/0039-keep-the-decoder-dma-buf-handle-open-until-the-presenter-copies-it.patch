 1 file changed, 69 insertion(s)

diff --git a/native/opennow-streamer/crates/opennow-streamer-platform-linux/src/frame_producer.rs b/native/opennow-streamer/crates/opennow-streamer-platform-linux/src/frame_producer.rs
index 81253d5..cd430a1 100644
--- a/native/opennow-streamer/crates/opennow-streamer-platform-linux/src/frame_producer.rs
+++ b/native/opennow-streamer/crates/opennow-streamer-platform-linux/src/frame_producer.rs
@@ -21,6 +21,26 @@
 const DRM_FORMAT_R8: u32 = u32::from_le_bytes(*b"R8  ");
 const DRM_FORMAT_GR88: u32 = u32::from_le_bytes(*b"GR88");
 const DECODE_WAIT_TIMEOUT: Duration = Duration::from_secs(1);
+/// How many compositor handoffs keep their decoder frame alive.
+///
+/// A compositor handoff exports only a descriptor: the two plane offsets, the
+/// strides and the dma-buf fds the decoder opened for them. Nothing here keeps
+/// those fds open afterwards. The caller that receives the descriptor is Qt's
+/// frame token, and the token is released as soon as the render pass that
+/// carries it ends, which drops the AVFrame that `video/ffmpeg.rs` retained for
+/// the frame and lets v4l2-request retire the output surface it decoded into.
+/// The compositor has not read the request yet: libwayland queued the `add` and
+/// `create_immed` pair when the stream surface sent it, and Weston imports the
+/// planes only when that message reaches it. A retired surface makes the import
+/// fail (`Failed to import plane 0 as R8` plus a protocol error that closes the
+/// stream window) and makes this crate's CPU copy fail with `Bad file
+/// descriptor (os error 9)` when the copy runs behind the decoder. Holding the
+/// frames whose descriptors went out for a fixed window keeps the surface, and
+/// the fds it named, alive until the queued copy and the compositor import have
+/// finished. The window is a ring, so the decoder is never asked to hold more
+/// than this many surfaces at a time: 24 frames is 0.4 s of video at 60 fps, a
+/// round trip the compositor cannot fall behind by.
+const COMPOSITOR_HANDOFF_RETAINED: usize = 24;
 const NV12_VERTEX_SHADER: &[u8] = include_bytes!("../shaders/nv12.vert.spv");
 const NV12_FRAGMENT_SHADER: &[u8] = include_bytes!("../shaders/embedded_yuv.frag.spv");
 const DEFAULT_FRAME_SLOTS: u32 = 3;
@@ -772,6 +792,10 @@
     buffer_imports: sand::BufferImports,
     renderers: HashMap<GpuTextureFormat, RendererResources>,
     slots: Vec<Option<FrameSlotResources>>,
+    /// Decoder frames whose DMA-BUF went to the compositor instead of the GPU,
+    /// oldest-next-to-be-retired first; see [`Self::retain_handoff_frame`].
+    handoff_frames: Vec<Option<Arc<DmaBufFrame>>>,
+    handoff_slot: usize,
     generation: u64,
     device_lost: bool,
 }
@@ -876,11 +900,35 @@
             buffer_imports: sand::BufferImports::default(),
             renderers: HashMap::new(),
             slots: (0..slot_count).map(|_| None).collect(),
+            handoff_frames: (0..COMPOSITOR_HANDOFF_RETAINED).map(|_| None).collect(),
+            handoff_slot: 0,
             generation: 0,
             device_lost: false,
         })
     }
 
+    /// Keeps the decoder frame whose DMA-BUF went to a compositor alive.
+    ///
+    /// [`export_dmabuf`] only copies the descriptor the kernel exported: the
+    /// fds it names belong to the dma-buf the decoder opened for this frame's
+    /// output surface, and nothing else in this crate still holds them once
+    /// the call returns. The compositor has not read them yet: the surface
+    /// queued `add` and `create_immed` when the frame was handed over and only
+    /// imports the planes when that message arrives, and this crate's CPU copy
+    /// maps the same fds when it runs behind the decoder. Retaining the frame
+    /// here is what keeps its surface, and the fds it named, alive over that
+    /// window; when the ring wraps, overwriting the oldest entry is what lets
+    /// the decoder recycle the surface again. The frame arrives through the
+    /// producer's own reference, so this never closes or duplicates a
+    /// descriptor: the fds the export names are the decoder's own.
+    fn retain_handoff_frame(&mut self, frame: &DecodedVideoFrame) {
+        let Some(dmabuf) = frame.dmabuf.as_ref() else {
+            return;
+        };
+        self.handoff_frames[self.handoff_slot] = Some(Arc::clone(dmabuf));
+        self.handoff_slot = (self.handoff_slot + 1) % COMPOSITOR_HANDOFF_RETAINED;
+    }
+
     /// Encodes NV12-to-RGBA into Qt's current Vulkan command buffer.
     ///
     /// The command buffer must be recording but outside a render pass. This
@@ -915,6 +963,27 @@
             // either: this path also runs when the interface renders with a
             // backend that has no Vulkan device to borrow.
             if let Some(dmabuf) = export_dmabuf(&frame) {
+                // The descriptor names fds this call does not keep: the token
+                // carrying it is released when the render pass ends, which
+                // drops the decoded frame and lets v4l2-request retire the
+                // output surface it decoded into. Weston imports the queued
+                // planes only when its message arrives, and this crate's CPU
+                // copy maps the same fds when it runs behind the decoder, so a
+                // retired surface fails the import (`Failed to import plane 0
+                // as R8`) and closes the stream window with a protocol error.
+                // Holding the frame itself over the handoff ring keeps the
+                // surface, and the fds it named, alive until both have read
+                // them; nothing here closes or duplicates a descriptor.
+                self.retain_handoff_frame(&frame);
+                {
+                    use std::sync::atomic::{AtomicBool, Ordering};
+                    static RETAINED_LOGGED: AtomicBool = AtomicBool::new(false);
+                    if !RETAINED_LOGGED.swap(true, Ordering::Relaxed) {
+                        eprintln!(
+                            "opennow-diag: dma-buf export handles kept alive at handoff: retained={COMPOSITOR_HANDOFF_RETAINED}"
+                        );
+                    }
+                }
                 return Ok(RecordedGpuFrame {
                     slot,
                     generation: self.generation,
