+/// Owns the FFmpeg frame plus this crate's duplicates of the descriptor's
+/// dma-buf handles; see `drm_frame` for why the duplicates exist. Closing the
+/// duplicates happens here, before the FFmpeg frame is dropped, so neither the
+/// presenter nor FFmpeg can see a closed handle while the frame is alive.
+struct OwnedDmaBufFrame {
+    video: frame::Video,
+    fds: Vec<c_int>,
+}
+
+impl Drop for OwnedDmaBufFrame {
+    fn drop(&mut self) {
+        for fd in &self.fds {
+            unsafe { libc::close(fd) };
+        }
+    }
+}
