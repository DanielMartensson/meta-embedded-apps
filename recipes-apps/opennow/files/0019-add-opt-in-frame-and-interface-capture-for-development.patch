+#if defined(Q_OS_LINUX)
+    // Development aid: creating /tmp/opennow-grab writes the interface window
+    // to /tmp/opennow-grab.png. The compositor on the reference board refuses
+    // screen capture, and the interface is invisible underneath the stream
+    // window, so this is the only way to see what the application is showing.
+    auto *grabTimer = new QTimer(&application);
+    grabTimer->setInterval(400);
+    QObject::connect(grabTimer, &QTimer::timeout, &application, [] {
+        const QString trigger = QStringLiteral("/tmp/opennow-grab");
+        if (!QFile::exists(trigger)) return;
+        QFile::remove(trigger);
+        QWindow *target = nullptr;
+        for (QWindow *window : QGuiApplication::topLevelWindows()) {
+            if (window->isVisible() && window->type() == Qt::Window) target = window;
+        }
+        if (!target) return;
+        auto *quickWindow = qobject_cast<QQuickWindow *>(target);
+        if (!quickWindow) return;
+        const QImage image = quickWindow->grabWindow();
+        if (image.isNull()) {
+            qWarning("window grab produced no image");
+            return;
+        }
+        const QString path = QStringLiteral("/tmp/opennow-grab.png");
+        qInfo("window grab saved: %s (%dx%d)", qUtf8Printable(path), image.width(),
+              image.height());
+        image.save(path);
+    });
+    grabTimer->start();
+#endif
     QObject::connect(&controller, &AppController::restartRequested, &application, [&] {
