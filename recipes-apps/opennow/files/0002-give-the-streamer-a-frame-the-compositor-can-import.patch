+/// A linear (unmodified) NV12 frame. The VeriSilicon driver cannot import
+/// DMA-BUF images, but it exposes the external buffer import extensions, so
+/// these frames can take the same VkBuffer path as the Broadcom tiled ones.
+pub(super) fn is_linear(frame: &DmaBufFrame) -> bool {
+    frame.layers.len() == 1
+        && frame.layers[0].format == DRM_FORMAT_NV12
+        && frame.layers[0].planes.len() == 2
