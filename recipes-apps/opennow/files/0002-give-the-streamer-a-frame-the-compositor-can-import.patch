+/// Cache-synchronised CPU mapping of one DMA-BUF object.
+struct DmaBufMapping {
+    fd: i32,
+    pointer: *mut u8,
+    length: usize,
+}
+
+const DMA_BUF_SYNC_READ: u64 = 1;
+const DMA_BUF_SYNC_START: u64 = 0;
+const DMA_BUF_SYNC_END: u64 = 4;
+// _IOW('b', 2, struct dma_buf_sync) on 64-bit Linux.
+const DMA_BUF_IOCTL_SYNC: libc::c_ulong = 0x4008_6202;
+
+impl DmaBufMapping {
+    fn new(fd: i32, length: usize) -> Result<Self> {
+        let pointer = unsafe {
+            libc::mmap(
+                std::ptr::null_mut(),
+                length,
+                libc::PROT_READ,
+                libc::MAP_SHARED,
+                fd,
+                0,
+            )
+        };
+        if pointer == libc::MAP_FAILED {
+            return Err(Error::backend(
+                crate::Subsystem::V4l2,
+                format!(
+                    "failed to map DMA-BUF for the CPU copy: {}",
+                    std::io::Error::last_os_error()
+                ),
+            ));
+        }
+        Ok(Self {
+            fd,
+            pointer: pointer.cast(),
+            length,
+        })
+    }
+
+    fn begin_read(&self) {
+        self.sync(DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ);
+    }
+
+    fn end_read(&self) {
+        self.sync(DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ);
+    }
+
+    fn sync(&self, flags: u64) {
+        #[repr(C)]
+        struct DmaBufSync {
+            flags: u64,
+        }
+        let sync = DmaBufSync { flags };
+        unsafe {
+            libc::ioctl(self.fd, DMA_BUF_IOCTL_SYNC, &sync);
+        }
+    }
+}
+
+impl Drop for DmaBufMapping {
+    fn drop(&mut self) {
+        unsafe {
+            libc::munmap(self.pointer.cast(), self.length);
+        }
+    }
+}
