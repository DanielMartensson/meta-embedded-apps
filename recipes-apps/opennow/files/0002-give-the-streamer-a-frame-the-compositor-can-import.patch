+/// One imported `TRANSFER_SRC` buffer, kept alive by the frames that still use
+/// it and by the cache between frames. The decoder pool reuses the same
+/// DMA-BUFs, so importing each one once avoids a driver allocation per frame.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+struct BufferKey {
+    device: u64,
+    inode: u64,
+    size: u64,
+}
+
+const BUFFER_CACHE_LIMIT: usize = 64;
+
+#[derive(Default)]
+pub(super) struct BufferImports {
+    entries: HashMap<BufferKey, (Arc<ImportedBuffer>, u64)>,
+    age: u64,
+}
+
+impl BufferImports {
+    fn get(
+        &mut self,
+        key: BufferKey,
+        instance: &ash::Instance,
+        physical: vk::PhysicalDevice,
+        device: &ash::Device,
+        object: &crate::DmaBufObject,
+    ) -> Result<Arc<ImportedBuffer>> {
+        self.age = self.age.wrapping_add(1);
+        if let Some((buffer, stamp)) = self.entries.get_mut(&key) {
+            *stamp = self.age;
+            return Ok(Arc::clone(buffer));
+        }
+        if self.entries.len() >= BUFFER_CACHE_LIMIT {
+            let oldest = self
+                .entries
+                .iter()
+                .filter(|(_, (buffer, _))| Arc::strong_count(buffer) == 1)
+                .min_by_key(|(_, (_, stamp))| *stamp)
+                .map(|(key, _)| *key);
+            if let Some(oldest) = oldest {
+                self.entries.remove(&oldest);
+            }
+        }
+        let buffer = Arc::new(import_buffer(instance, physical, device, object, key.size)?);
+        self.entries.insert(key, (Arc::clone(&buffer), self.age));
+        Ok(buffer)
+    }
+}
