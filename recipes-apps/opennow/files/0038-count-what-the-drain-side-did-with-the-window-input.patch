From 22bb33cc44dd55ee66ff77aa88bb99cc00dd11ee22bb Mon Sep 17 00:00:00 2001
From: noname <noname@example.com>
Date: Tue, 3 Nov 2026 21:35:00 +0000
Subject: [PATCH] 0038 count what the drain side did with the window's input

Every counter this series has is on the embedder's side. A player who presses
Enter over the stream, in Steam's own window that the cloud host draws inside
the video, gets three green lights: the compositor says it saw the key (`wayland-video input: key 1 vk=0x1b mods=0x0 pressed=1`), the window says the
streamer did not refuse it (0 `submit refused` out of 154 key events), and the
queue says capture is active (`wayland-video input: capture active`). `play-portal3.log` (PID 9242, session 21:04-21:25) is the run that proved all three
and still shows the press never arriving:

  2234 x command=0x010f      the host's own cursor reports, 31 per second
     1 x command=0x030d      remote cursor tracking, armed
     1 x command=0x0308      mouse cursor capture, armed, never disabled
   keys=154 pointers=23 buttons=86 refused=0 relative=0

The control channel is therefore healthy and the window is sending; what the log
cannot say is whether anything went out on the *input* channel. The drain has no
counter at all, and the branch above it is a silent drop: while
`feedback_state.input_available` is false - it starts false and only becomes
true on the host's `InputReady` event - every sample the window queued is
`captured_input.clear()`-ed. A press made between the window opening and that
event, which is exactly where Steam's notice is, is thrown away with no mark.

This adds the drain's own counters and says them every 5 s,

  NVST native input drain: available={} clearedPolls={} keys={} absolutes={}
      moves={} buttons={}

so the next session can put the embedder's counts (`wayland-video input: key ...`)
beside what the drain forwarded, and a nonzero `clearedPolls` names the drop as
the reason a press never left the board. The counters are integers on the loop's
own frame and the line is one per 5 s; nothing is buffered.

Upstream-Status: Inappropriate [STM32MP25 performance work]

--- a/native/opennow-streamer/crates/opennow-streamer-core/src/lib.rs
+++ b/native/opennow-streamer/crates/opennow-streamer-core/src/lib.rs
@@ -1941,6 +1941,20 @@
     let mut pending_rumble = [None; 4];
     let mut pending_input = None;
     let mut sent_mouse_settings = None;
+    // What the drain side actually did with the events the embedder handed it.
+    // The player's complaint is that a press made over the stream never arrives,
+    // and every counter that exists so far is on the embedder's side: the window
+    // says it sent a key and the streamer says it was not refused, which is true
+    // of the queue and says nothing about the wire. These counters answer the
+    // half that matters, and the cleared-poll counter names the branch above
+    // them, which drops everything the window queued before the host opened its
+    // input channel.
+    let mut drainAt = Instant::now();
+    let mut drainClearedPolls = 0usize;
+    let mut drainKeys = 0usize;
+    let mut drainAbsolute = 0usize;
+    let mut drainMoves = 0usize;
+    let mut drainButtons = 0usize;
     let mut pending_control_output = NvstControlOutput {
         start_id: start_id.clone(),
         pending: None,
@@ -1949,6 +1963,19 @@
     };
     'session: loop {
         flush_control_output(output, lifecycle, generation, &mut pending_control_output);
+        let drainNow = Instant::now();
+        if drainNow >= drainAt {
+            drainAt = drainNow + Duration::from_secs(5);
+            eprintln!(
+                "NVST native input drain: available={} clearedPolls={} keys={} absolutes={} moves={} buttons={}",
+                feedback_state.input_available,
+                drainClearedPolls,
+                drainKeys,
+                drainAbsolute,
+                drainMoves,
+                drainButtons,
+            );
+        }
         if let Some(feedback) = media_feedback.as_ref() {
             while let Ok(feedback) = feedback.try_recv() {
                 forward_nvst_media_feedback(
@@ -1991,6 +2018,7 @@
         if let Some(captured_input) = captured_input.as_ref() {
             if !feedback_state.input_available {
                 if pending_input.is_none() {
+                    drainClearedPolls += 1;
                     captured_input.clear();
                 }
             } else if captured_input.take_overflowed() {
@@ -2072,6 +2100,13 @@
                         );
                         break 'session;
                     }
+                    match input.input {
+                        CapturedInput::Key { .. } => drainKeys += 1,
+                        CapturedInput::MouseAbsolute { .. } => drainAbsolute += 1,
+                        CapturedInput::MouseMove { .. } => drainMoves += 1,
+                        CapturedInput::MouseButton { .. } => drainButtons += 1,
+                        _ => {}
+                    }
                 }
             }
         }
