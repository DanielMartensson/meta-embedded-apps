@@ -205,6 +210,7 @@ private:
     xdg_wm_base *m_shell = nullptr;
     zwp_linux_dmabuf_v1 *m_dmabuf = nullptr;
     wl_seat *m_seat = nullptr;
+    quint32 m_seatCapabilities = 0;
     wl_keyboard *m_keyboard = nullptr;
