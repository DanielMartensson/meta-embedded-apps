From 8e9f0a1b2c3d4e5f60718293a4b5c6d7e8f9012b Mon Sep 17 00:00:00 2001
From: noname <noname@example.com>
Date: Tue, 3 Nov 2026 18:40:00 +0000
Subject: [PATCH] 0036 never close the compositor's own connection as a frame
 descriptor

Two Destiny 2 sessions on the r0.61 build lost their stream window before the
first frame, and the second one names the mechanism. Run 10
(`play-dstny10.log`, PID 48992) created the window at 17:01:16.011, created four
wl_buffers over the next 94 ms, and then at 17:01:16.121:

  wayland-video: the compositor connection failed: Socket operation on non-socket
  wayland-video: flush failed: Socket operation on non-socket (display error 88)
  wayland-video: stream window closed

ENOTSOCK is what sendmsg answers when the descriptor is not a socket, so by then
this surface's own connection number named something else. The streamer exports
a fresh dma-buf descriptor for every frame out of a pool this board churns
through, and a number it has already closed is handed back out to the next
open() in the process - including wl_display_connect's socket. present() closes
every frame descriptor that no request carried, and that close is correct for
every number except this one. It now refuses that number and says so once:

  opennow-diag: frame fd %d is the compositor connection; not closing it

The frame is lost either way; the window is not.

Upstream-Status: Inappropriate [STM32MP25 performance work]

diff --git a/opennow-qt/src/streaming/rendering/WaylandVideoSurface.cpp b/opennow-qt/src/streaming/rendering/WaylandVideoSurface.cpp
--- a/opennow-qt/src/streaming/rendering/WaylandVideoSurface.cpp
+++ b/opennow-qt/src/streaming/rendering/WaylandVideoSurface.cpp
@@ -1149,7 +1149,30 @@
     if (frame.fd >= 0) {
         // A descriptor that went into a request belongs to libwayland now and
         // is tracked by bufferFor(); one that never got there is ours to close.
-        if (!handedOver) ::close(frame.fd);
+        //
+        // One number is never ours: the compositor's own connection. The
+        // decoder exports a fresh descriptor for every frame from a pool this
+        // board churns through, and a number the streamer has already closed can
+        // be handed back out to this surface's wl_display_connect socket. Run 10
+        // (`play-dstny10.log`) lost its window 110 ms after creating it with
+        //
+        //   wayland-video: the compositor connection failed: Socket operation
+        //     on non-socket
+        //   wayland-video: flush failed: Socket operation on non-socket
+        //     (display error 88)
+        //
+        // which is what sendmsg answers when the socket number now names a
+        // dma-buf: this close landed on the connection. Refusing it costs one
+        // stale number and keeps the window; the picture it carried is already
+        // lost either way.
+        if (m_display && frame.fd == wl_display_get_fd(m_display)) {
+            static int refused = 0;
+            if (refused++ == 0)
+                qWarning("opennow-diag: frame fd %d is the compositor connection; not closing it",
+                         frame.fd);
+        } else if (!handedOver) {
+            ::close(frame.fd);
+        }
     }
 
     const quint64 now = monotonicNs();

