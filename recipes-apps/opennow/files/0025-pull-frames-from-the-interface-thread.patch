+    // A compositor-bound frame carries the decoder's DMA-BUF instead of a
+    // converted GPU texture. Handing it to the stream window keeps the whole
+    // 1080p conversion and the sampled copy out of the frame, which is what the
+    // GPU cannot afford on this board. Nothing here touches Qt's render pass:
+    // no shader, no texture, no command buffer, so any Qt backend works.
+    void pullWaylandFrame() { presentWaylandFrame(); }
+
+    void presentWaylandFrame()
+    {
+        OpenNowStreamerRecordCommand command{};
+        command.version = OPENNOW_STREAMER_RENDER_COMMAND_VERSION;
+        command.struct_size = sizeof(command);
+        // The compositor path records nothing, but the native side rejects a
+        // null handle before it looks at the frame, so hand it a marker that is
+        // never dereferenced.
+        command.command_buffer = reinterpret_cast<void *>(quintptr(1));
+        OpenNowStreamerFrameInfo info{};
+        OpenNowStreamerRecordedFrame recorded{};
+        OpenNowStreamerFrame *frame = nullptr;
+        const auto status = m_runtime->recordLatestFrame(command, &info, &recorded, &frame);
+        const bool usable = status == OPENNOW_STREAMER_OK && frame && recorded.dmabuf_fd >= 0
+            && m_presentationGeneration == m_runtime->presentationGeneration()
+            && m_runtime->presentationAllowed();
+        if (usable) {
+            WaylandVideoSurface::Frame videoFrame;
+            videoFrame.fd = recorded.dmabuf_fd;
+            videoFrame.format = recorded.dmabuf_format;
+            videoFrame.modifier = recorded.dmabuf_modifier;
+            videoFrame.size = QSize(int(recorded.dmabuf_width), int(recorded.dmabuf_height));
+            videoFrame.planeCount = recorded.dmabuf_plane_count;
+            for (int plane = 0; plane < 2; ++plane) {
+                videoFrame.offsets[plane] = recorded.dmabuf_plane_offset[plane];
+                videoFrame.strides[plane] = recorded.dmabuf_plane_stride[plane];
+            }
+            auto *surface = WaylandVideoSurface::instance();
+            // AutoConnection: a direct call from the pull clock, a queued one if
+            // this ever runs in a render pass again.
+            QMetaObject::invokeMethod(surface, [surface, videoFrame] {
+                surface->present(videoFrame);
+            }, Qt::AutoConnection);
+            m_waylandVideo = true;
+            m_outputKind = 0;
+            m_outputDirty = false;
+        } else if (status == OPENNOW_STREAMER_OK && recorded.dmabuf_fd < 0) {
+            reportFailure(QStringLiteral("The decoder handed over no DMA-BUF frame. Set OPENNOW_WAYLAND_VIDEO=0 to present inside the interface again."));
+            m_waylandVideo = false;
+        } else if (status != OPENNOW_STREAMER_OK && status != OPENNOW_STREAMER_NO_FRAME
+                   && status != OPENNOW_STREAMER_STALE_FRAME
+                   && status != OPENNOW_STREAMER_CLOSED
+                   && status != OPENNOW_STREAMER_GRAPHICS_UNAVAILABLE
+                   && status != OPENNOW_STREAMER_SCENE_GRAPH_ACTIVE
+                   && status != OPENNOW_STREAMER_WRONG_THREAD) {
+            m_waylandVideo = false;
+            reportFailure(QStringLiteral("Could not hand the decoded frame to the compositor (status %1). Check native-streamer.log for decoder errors.").arg(int(status)));
+        }
+        if (frame) m_runtime->releaseFrame(frame);
+        // Keep the interface asking for frames: it drives the pull while the
+        // stream window owns the picture.
+        m_needsFrame.store(true);
+    }
+#endif
