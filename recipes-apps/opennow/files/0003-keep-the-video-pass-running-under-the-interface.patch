+namespace {
+// Temporary instrumentation (OPENNOW_LOG_FRAME_RATES): per second counts of the
+// native "a decoded frame is ready" notifications and of the drains that deliver
+// them to the GUI thread. Locates the presentation bottleneck between the
+// decoder and the window swap.
+const bool g_frameRates = qEnvironmentVariableIsSet("OPENNOW_LOG_FRAME_RATES");
+std::atomic<quint64> g_frameNotified{0};
+std::atomic<quint64> g_frameDelivered{0};
+
+void reportFrameRates()
+{
+    if (!g_frameRates) return;
+    static qint64 lastReport = 0;
+    static quint64 lastNotified = 0;
+    static quint64 lastDelivered = 0;
+    const qint64 now = QDateTime::currentMSecsSinceEpoch();
+    if (lastReport == 0) {
+        lastReport = now;
+        lastNotified = g_frameNotified.load();
+        lastDelivered = g_frameDelivered.load();
+        return;
+    }
+    const qint64 elapsed = now - lastReport;
+    if (elapsed < 1000) return;
+    const quint64 notified = g_frameNotified.load();
+    const quint64 delivered = g_frameDelivered.load();
+    const double seconds = double(elapsed) / 1000.0;
+    qInfo("opennow-frame-rate native=%.1f/s delivered=%.1f/s",
+          double(notified - lastNotified) / seconds, double(delivered - lastDelivered) / seconds);
+    lastReport = now;
+    lastNotified = notified;
+    lastDelivered = delivered;
+}
+} // namespace
+
 void NativeStreamRuntime::enqueueFrameAvailable(CallbackState *state)
 {
     if (!state) return;
+    if (g_frameRates) g_frameNotified.fetch_add(1, std::memory_order_relaxed);
     const auto sharedState = state->shared_from_this();
     bool shouldSchedule = false;
     {
@@ -1167,6 +1203,8 @@ void NativeStreamRuntime::drainCallbacks(const std::shared_ptr<CallbackState> &s
             d->firstNotification = true;
         }
         emit frameAvailable();
+        if (g_frameRates) g_frameDelivered.fetch_add(1, std::memory_order_relaxed);
+        reportFrameRates();
         if (!current()) return;
     }
     while (!messages.isEmpty()) {
