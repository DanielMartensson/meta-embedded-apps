+    // Diagnostics only: OPENNOW_VIDEO_MODE_FILE names a small file that selects
+    // what the video pass has to do, so the cost of the texture fetch and of the
+    // ordered dither can be attributed while a stream is running, without a
+    // rebuild or a restart. "nofetch" collapses the video rect, which makes the
+    // shader skip the fetch entirely, "nodither" keeps the fetch and drops the
+    // dither, and anything else is the normal pass.
+    void applyDebugVideoMode()
+    {
+        static const QByteArray path = qgetenv("OPENNOW_VIDEO_MODE_FILE");
+        static QByteArray lastMode;
+        if (path.isEmpty()) return;
+        QFile file(QString::fromLocal8Bit(path));
+        if (!file.open(QIODevice::ReadOnly)) return;
+        const QByteArray mode = file.readAll().trimmed();
+        if (mode != lastMode) {
+            lastMode = mode;
+            qInfo("video debug mode: %s", mode.constData());
+        }
+        if (mode == QByteArrayLiteral("nofetch")) {
+            m_composition[20] = 0.0f;
+            m_composition[21] = 0.0f;
+            m_composition[22] = 0.0f;
+            m_composition[23] = 0.0f;
+        } else if (mode == QByteArrayLiteral("nodither")) {
+            m_composition[25] = 0.0f;
+        }
     }
 
