+// This Qt build exposes the VkInstance and its function table but no device
+// list, so enumerate the physical devices through Vulkan directly.
+inline QList<VkPhysicalDevice> physicalDevicesOf(QVulkanInstance *instance)
+{
+    QList<VkPhysicalDevice> devices;
+    if (!instance || !instance->functions() || instance->vkInstance() == VK_NULL_HANDLE)
+        return devices;
+    uint32_t count = 0;
+    if (instance->functions()->vkEnumeratePhysicalDevices(instance->vkInstance(), &count, nullptr)
+            != VK_SUCCESS || count == 0)
+        return devices;
+    devices.resize(count);
+    if (instance->functions()->vkEnumeratePhysicalDevices(instance->vkInstance(), &count, devices.data())
+            != VK_SUCCESS)
+        devices.clear();
+    else
+        devices.resize(count);
+    return devices;
+}
+
+// Extensions Qt is asked to enable on its device. A requested extension the
+// driver does not offer only produces a warning from Qt and is dropped there, so
+// ask for the intersection with what the physical device actually exposes: on a
+// board without VK_EXT_image_drm_format_modifier the import contract below
+// reports the gap anyway, and the console stays clean.
+inline QByteArrayList availableDeviceExtensions(QVulkanInstance *instance)
+{
+    QByteArrayList available;
+    if (!instance || !instance->functions()) return available;
+    for (VkPhysicalDevice device : physicalDevicesOf(instance)) {
+        uint32_t count = 0;
+        if (instance->functions()->vkEnumerateDeviceExtensionProperties(
+                device, nullptr, &count, nullptr) != VK_SUCCESS
+                || count == 0)
+            continue;
+        QList<VkExtensionProperties> properties(count);
+        if (instance->functions()->vkEnumerateDeviceExtensionProperties(
+                device, nullptr, &count, properties.data()) != VK_SUCCESS)
+            continue;
+        properties.resize(count);
+        for (const auto &property : properties) {
+            const QByteArray name(property.extensionName);
+            if (!available.contains(name)) available.append(name);
+        }
+    }
+    return available;
+}
+
+// Qt leaves VkApplicationInfo::apiVersion at 0 when nothing was requested, and
+// the loader rejects that (VUID-VkApplicationInfo-apiVersion). Ask for the
+// version the loader reports; these probes only enumerate, so any version works.
+inline void setSupportedApiVersion(QVulkanInstance &instance)
+{
+    const QVersionNumber supported = instance.supportedApiVersion();
+    if (!supported.isNull())
+        instance.setApiVersion(supported);
+}
