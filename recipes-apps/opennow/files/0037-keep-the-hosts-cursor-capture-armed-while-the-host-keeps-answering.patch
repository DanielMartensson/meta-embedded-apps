From 11aa22bb33cc44dd55ee66ff77aa88bb99cc00dd Mon Sep 17 00:00:00 2001
From: noname <noname@example.com>
Date: Tue, 3 Nov 2026 20:05:00 +0000
Subject: [PATCH] 0037 keep the host's cursor capture armed while the host keeps
 answering

The player's complaint is the same in two cloud games now, which says it is not
the game. Portal 2 (`play-portal1.log`, PID 8502, session 19:36:57-19:40:51) and
Destiny 2 (`play-btn1.log`) both put a cursor on the cloud host's own desktop -
Steam's in-stream notice, its "ok" button - inside the video, and the player
cannot move it:

  19:39:53.085 wayland-video input: streamer capture requested=0 inputAllowed=1
  19:39:53.146 wayland-video input: the seat now has a pointer
  19:39:53.148 wayland-video: stream window created
  19:39:53.164 wayland-video input: streamer capture requested=1 inputAllowed=1
  19:39:53.166 wayland-video input: capture active
  19:39:54.162 wayland-video fps=42.4 committed=44 dropped=0 flushFailed=0
  ... 9 absolute pointer submissions and 16 button transitions, 0 submit refused
  ... 0 `wayland-video input: relative`, so the window aimed with a position
  ... 0 `dropping a frame`, 0 `Socket operation`, 0 `invalid fence`

And the control channel:

  NVST cursor capture tx: channel=control_channel_reliable command=0x0308
      enabled=true reason=input-activation
  NVST remote cursor tracking tx: channel=control_channel_reliable command=0x030d
      enabled=true reason=input-activation
  NVST cursor wire rx: channel=control_channel_reliable id=ChannelId(0)
      command=0x010f cursorId=Some(1) position=Some((32784, 32797))
      visible=Some(false) bytes=13 raw=0f0109000100000010801d8000
  NVST cursor capture tx: command=0x0308 enabled=false reason=cursor-notification
      attempt=1 queued=true

(32784, 32797) is 0.5003 and 0.5001: the host's own cursor, dead centre, and it
is the only cursor report of the whole 60 s, so that is where it stayed for the
rest of the session. `submit refused` counted nothing because nothing was
refused: the app's positions reach the streamer's queue, and what stops them is
`NvstCursorCapture` upstream, which answers the FIRST cursor report from the
host by sending command 0x0308 enabled=false - "stop warping my cursor to where
the client points" - and moving to `CaptureState::Local`, "the app draws its own
cursor", for the rest of the session. A cursor report is the host answering the
capture request with where its cursor is and whether it hides it; it is not a
reason to stop asking, and the timeout right beside it is the reason that is
actually meant: a host that never answers at all.

The notification now renews the silence window and keeps the request armed, and
says so once:

  NVST cursor report keeps the capture request armed: reason=cursor-report
      deadlineRenewed=true

A host that goes silent still loses capture after the renewed window and the
window then paints its own cursor, which is what the `silent-host-timeout`
disable and the app's `cursorCaptureChanged` handoff are for. The state
machine's own unit tests carry the new expectations: the report renews rather
than disables, a report can no longer run the disable retry loop, and the
bounded enable retries and the silence fallback are still asserted.

Upstream-Status: Inappropriate [STM32MP25 performance work]

--- a/native/opennow-streamer/crates/opennow-streamer-transport/src/nvst_cursor.rs
+++ b/native/opennow-streamer/crates/opennow-streamer-transport/src/nvst_cursor.rs
@@ -46,6 +46,9 @@
 #[derive(Debug, Default)]
 pub(crate) struct NvstCursorCapture {
     state: CaptureState,
+    // Whether a cursor report from the host has already been reported, so the
+    // arming says so once per session rather than on every report.
+    reported: bool,
 }
 
 impl NvstCursorCapture {
@@ -59,15 +62,36 @@
 
     pub(crate) fn reset(&mut self) {
         self.state = CaptureState::Inactive;
+        self.reported = false;
     }
 
     pub(crate) fn notify(&mut self, now: Instant) {
-        if matches!(self.state, CaptureState::Waiting { .. }) {
-            self.state = CaptureState::Disabling {
-                retry_at: now,
-                attempts: 0,
-                reason: "cursor-notification",
-            };
+        // A cursor report from the host is the host answering the capture
+        // request: it carries where its own cursor is and whether it hides it.
+        // Upstream answered the first of these by sending command 0x0308
+        // enabled=false and taking a "paint our own cursor" handoff for the
+        // rest of the session, which is what the player saw twice on this
+        // board, in Destiny 2 and again in Portal 2: the provider's cursor is
+        // visible in the video at position=Some((32784, 32797)) = 0.5003,
+        // 0.5001 = dead centre and never moves, so Steam's in-stream notice
+        // cannot be clicked and an aim lands wherever that frozen cursor sat.
+        // A report is evidence the host is answering, so it renews the silence
+        // window instead and keeps the request armed; only a host that never
+        // answers at all still loses capture, and only then does the window
+        // paint its own cursor.
+        match &self.state {
+            CaptureState::Waiting { .. } | CaptureState::Disabling { .. } => {
+                if !self.reported {
+                    self.reported = true;
+                    eprintln!("NVST cursor report keeps the capture request armed: reason=cursor-report deadlineRenewed=true");
+                }
+                self.state = CaptureState::Waiting {
+                    deadline: now + SILENT_HOST_TIMEOUT,
+                    retry_at: now + RETRY_INTERVAL,
+                    attempts: 1,
+                };
+            }
+            CaptureState::Inactive | CaptureState::Local | CaptureState::Exhausted => {}
         }
     }
 
