     [[nodiscard]] quint16 wireModifiers(quint16 virtualKey) const;
     [[nodiscard]] static quint16 virtualKeyFor(quint32 evdev);
 
@@ -264,6 +279,11 @@
     // The clock that keeps the capture state this window asked for applied
