+void WaylandVideoSurface::submitPointer(double x, double y)
+{
+    if (!m_input.absolute || !m_videoSize.isValid()) return;
+    // The surface carries the whole frame: unscaled when it is fullscreen, at
+    // the window's destination size when it is windowed. The host gets the
+    // point in the video's own pixels.
+    const QSizeF surfaceSize = m_windowed ? QSizeF(kWindowWidth, kWindowHeight)
+                                          : QSizeF(m_videoSize);
+    if (surfaceSize.width() <= 0 || surfaceSize.height() <= 0) return;
+    const double videoX = std::clamp(x * m_videoSize.width() / surfaceSize.width(), 0.0,
+                                     double(m_videoSize.width() - 1));
+    const double videoY = std::clamp(y * m_videoSize.height() / surfaceSize.height(), 0.0,
+                                     double(m_videoSize.height() - 1));
+    m_input.absolute(int(std::lround(videoX)), int(std::lround(videoY)),
+                     m_videoSize.width(), m_videoSize.height());
+    static quint64 lastLog = 0;
+    const quint64 now = monotonicNs();
+    if (qEnvironmentVariableIsSet("OPENNOW_LOG_INPUT") && now - lastLog > 500'000'000ull) {
+        lastLog = now;
+        qInfo("wayland-video input: pointer %dx%d of %dx%d", int(videoX), int(videoY),
+              m_videoSize.width(), m_videoSize.height());
+    }
+}
+
+void WaylandVideoSurface::submitKey(quint32 evdev, bool pressed)
+{
+    if (!m_input.key) return;
+    const quint16 virtualKey = virtualKeyFor(evdev);
+    if (virtualKey == 0) return;
+    if (pressed) {
+        if (m_heldKeys.contains(evdev)) return;  // compositor auto-repeat
+        m_heldKeys.insert(evdev);
+    } else if (!m_heldKeys.remove(evdev)) {
+        return;
+    }
+    const quint16 modifiers = wireModifiers(virtualKey);
+    m_input.key(virtualKey, modifiers, pressed);
+    if (qEnvironmentVariableIsSet("OPENNOW_LOG_INPUT"))
+        qInfo("wayland-video input: key %u vk=0x%x mods=0x%x pressed=%d", evdev, virtualKey,
+              modifiers, pressed);
+}
+
+void WaylandVideoSurface::releaseHeldKeys()
+{
+    if (m_input.key) {
+        for (const quint32 evdev : std::as_const(m_heldKeys))
+            m_input.key(virtualKeyFor(evdev), 0, false);
+    }
+    m_heldKeys.clear();
+}
