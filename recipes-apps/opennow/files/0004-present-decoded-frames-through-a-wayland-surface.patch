+/// Duplicates the decoder's DMA-BUF into a [`DmabufExport`]. The receiver owns
+/// the returned descriptor. Frames whose planes do not share one object, or
+/// that are not DMA-BUFs at all, are left to the GPU path.
+fn export_dmabuf(frame: &DecodedVideoFrame) -> Option<DmabufExport> {
+    let dmabuf = frame.dmabuf.as_ref()?;
+    let layer = dmabuf.layers.first()?;
+    if layer.planes.is_empty() || layer.planes.len() > 2 {
+        return None;
+    }
+    let first = layer.planes[0];
+    if first.object_index >= dmabuf.objects.len()
+        || layer
+            .planes
+            .iter()
+            .any(|plane| plane.object_index != first.object_index)
+    {
+        return None;
+    }
+    let object = dmabuf.objects[first.object_index];
+    let fd = unsafe { libc::fcntl(object.fd, libc::F_DUPFD_CLOEXEC, 3) };
+    if fd < 0 {
+        return None;
+    }
+    // The buffer is described at the visible height even when the decoder pads
+    // the picture (1088 rows for 1080p): the planes carry their own offsets, so
+    // the extra rows never reach the compositor, and a surface matching the
+    // fullscreen size is the only kind the compositor accepts.
+    let mut export = DmabufExport {
+        fd,
+        format: layer.format,
+        modifier: object.format_modifier,
+        width: frame.format.width,
+        height: frame.format.height,
+        plane_count: layer.planes.len() as u32,
+        ..DmabufExport::default()
+    };
+    for (index, plane) in layer.planes.iter().enumerate() {
+        export.plane_offset[index] = u32::try_from(plane.offset).ok()?;
+        export.plane_stride[index] = u32::try_from(plane.pitch).ok()?;
+    }
+    Some(export)
+}
