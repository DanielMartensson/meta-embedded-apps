--- /dev/null
+++ b/opennow-qt/src/streaming/rendering/WaylandVideoSurface.h
@@ -0,0 +1,87 @@
+#pragma once
+
+#include <QObject>
+#include <QSize>
+#include <cstdint>
+
+struct wl_array;
+struct wl_buffer;
+struct wl_compositor;
+struct wl_display;
+struct wl_registry;
+struct wl_surface;
+struct xdg_surface;
+struct xdg_toplevel;
+struct xdg_wm_base;
+struct zwp_linux_dmabuf_v1;
+
+// Presents decoded frames on a Wayland surface of its own instead of handing
+// them to the Qt scene graph. The decoder writes NV12 into a DMA-BUF that the
+// compositor can take straight to a plane, so nothing on the GPU has to convert
+// or copy a 1080p frame before it reaches the screen. The surface is created on
+// demand, ignores input (the Qt window underneath keeps receiving it) and is
+// torn down when the stream ends.
+class WaylandVideoSurface final : public QObject
+{
+    Q_OBJECT
+public:
+    struct Frame {
+        int fd = -1;
+        quint32 format = 0;
+        quint64 modifier = 0;
+        QSize size;
+        quint32 planeCount = 0;
+        quint32 offsets[2] = {0, 0};
+        quint32 strides[2] = {0, 0};
+    };
+
+    // One process-wide surface: the compositor connection comes from Qt, and a
+    // stream has exactly one video window.
+    static WaylandVideoSurface *instance();
+    static bool environmentEnabled();
+
+    // Takes ownership of frame.fd and closes it whatever happens.
+    void present(Frame frame);
+    void dismiss();
+
+    [[nodiscard]] bool isMapped() const { return m_mapped; }
+    [[nodiscard]] quint64 committed() const { return m_committed; }
+    [[nodiscard]] quint64 dropped() const { return m_dropped; }
+
+private:
+    explicit WaylandVideoSurface(QObject *parent = nullptr);
+    ~WaylandVideoSurface() override;
+
+    bool ensureSurface();
+    void destroySurface();
+    bool ensureDmabuf();
+    void attachFrame(const Frame &frame);
+    void flushDisplay();
+
+    static void handleGlobal(void *data, wl_registry *registry, quint32 name,
+                             const char *interface, quint32 version);
+    static void handleGlobalRemove(void *data, wl_registry *registry, quint32 name);
+    static void handlePing(void *data, xdg_wm_base *shell, quint32 serial);
+    static void handleConfigure(void *data, xdg_surface *surface, quint32 serial);
+    static void handleToplevelConfigure(void *data, xdg_toplevel *toplevel,
+                                       qint32 width, qint32 height, wl_array *states);
+    static void handleToplevelClose(void *data, xdg_toplevel *toplevel);
+    static void handleBufferRelease(void *data, wl_buffer *buffer);
+
+    wl_display *m_display = nullptr;
+    wl_registry *m_registry = nullptr;
+    wl_compositor *m_compositor = nullptr;
+    xdg_wm_base *m_shell = nullptr;
+    zwp_linux_dmabuf_v1 *m_dmabuf = nullptr;
+
+    wl_surface *m_surface = nullptr;
+    xdg_surface *m_xdgSurface = nullptr;
+    xdg_toplevel *m_toplevel = nullptr;
+    wl_buffer *m_pendingBuffer = nullptr;
+    bool m_configured = false;
+    bool m_mapped = false;
+    quint64 m_committed = 0;
+    quint64 m_dropped = 0;
+    quint64 m_sampleStart = 0;
+    quint64 m_sampleCount = 0;
+};
