From db9ce7544f72e268cd57a11978e4bb8f0f16381d Mon Sep 17 00:00:00 2001
From: noname <noname@example.com>
Date: Sun, 1 Nov 2026 21:14:28 +0100
Subject: [PATCH] 0030 keep an artwork object out of the cache unless its bytes
 hold a whole image

The terminal of two of this boot's sessions shows a warning the diagnostics
log never carries, because Qt writes it to stderr beside the stream that was
still running at 53 fps:

  qt.gui.imageio.jpeg: Corrupt JPEG data: premature end of data segment
  QFile::at: Cannot set file position 49152
  QFile::at: Cannot set file position 163840
  QFile::at: Cannot set file position 327680

`c53` logged that pair seven times inside one second (17:28:00.150..17:28:01.094)
while the stream carried on around it, and the seek positions it asked for -
16384, 49152, 163840, 212992, 272261, 327680 - sit inside objects of the size
the artwork cache holds now, 385157 and 241834 bytes. The interface decodes the
cached object through a QFile, and the restart scans of its JPEG decoder seek
forward for the next segment; every seek that failed asked for an offset past
the end of the file, so the object on disk was shorter than the image it was
stored for. `download()` never compares the image it wrote against one its own
format promises: it rejects only an object *over* `max_object_bytes`, so a body
that ended early became a cache object and the interface decoded a half-image.

An object that no longer carries the image it was given is not an object, so
`holds_whole_image` checks the end-of-frame marker the sniffed format promises
(`FF D9` for a JPEG, the `IEND` chunk for a PNG) before the object is stored,
and the same path `too-large` already takes leaves the entry for a later
attempt instead: the artwork resolves on the next poll, and only whole images
reach the interface.

Marker: `truncated-image`.
---
 native/opennow-core/src/artwork_cache.rs | 32 ++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/native/opennow-core/src/artwork_cache.rs b/native/opennow-core/src/artwork_cache.rs
index 70251c2..a1bcbbe 100644
--- a/native/opennow-core/src/artwork_cache.rs
+++ b/native/opennow-core/src/artwork_cache.rs
@@ -548,6 +548,10 @@ fn download(state: &SharedState, job: &DownloadJob) -> Result<CachedObject, &'st
         let _ = fs::remove_file(&temporary);
         "unsupported-content"
     })?;
+    if !holds_whole_image(&extension, &temporary) {
+        let _ = fs::remove_file(&temporary);
+        return Err("truncated-image");
+    }
     let result = state
         .store_download(&job.key, extension, &temporary, total)
         .map_err(|_| "storage-error");
@@ -557,6 +561,34 @@ fn download(state: &SharedState, job: &DownloadJob) -> Result<CachedObject, &'st
     result
 }
 
+// Whether the bytes given for an image end where the image's own format says
+// they should. A JPEG is only complete once its end-of-frame marker is there,
+// and a PNG once its `IEND` chunk is; an object that stopped earlier is a
+// half-image and must not be handed to the interface, whose decoder restart-scans
+// for the next segment through a QFile and would ask for offsets the file does
+// not have (`QFile::at: Cannot set file position 327680` beside
+// `qt.gui.imageio.jpeg: Corrupt JPEG data: premature end of data segment`).
+fn holds_whole_image(extension: &str, path: &Path) -> bool {
+    let trailer: Vec<u8> = match extension.to_ascii_lowercase().as_str() {
+        "jpg" | "jpeg" => vec![0xff_u8, 0xd9_u8],
+        "png" => vec![0x49_u8, 0x45_u8, 0x44_u8, 0x0a_u8, 0x49_u8, 0x45_u8,
+                      0x4e_u8, 0x44_u8, 0xae_u8, 0x42_u8, 0x41_u8, 0x0d_u8, 0x0a_u8],
+        _ => return true,
+    };
+    let opened = OpenOptions::new().read(true).open(path);
+    if opened.is_err() {
+        // An unopenable path is not a refusal: nothing here can be compared.
+        return true;
+    }
+    let mut bytes: Vec<u8> = Vec::new();
+    match opened.unwrap().read_to_end(&mut bytes) {
+        // A read that fails is not a refusal: the store path reports it.
+        Err(_) => true,
+        Ok(_) => bytes.len() >= trailer.len()
+            && &bytes[bytes.len() - trailer.len()..] == &trailer[..],
+    }
+}
