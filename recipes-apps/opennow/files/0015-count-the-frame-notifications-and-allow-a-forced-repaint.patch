+    // Temporary instrumentation: drive the repaint at a fixed rate so the
+    // presentation path can be measured independently of the native frame
+    // notification rate (for example OPENNOW_FORCE_REPAINT_HZ=60).
+    if (const QByteArray forced = qgetenv("OPENNOW_FORCE_REPAINT_HZ"); !forced.isEmpty()) {
+        const int target = qBound(1, forced.toInt(), 240);
+        auto *timer = new QTimer(this);
+        timer->setTimerType(Qt::PreciseTimer);
+        timer->setInterval(qMax(1, 1000 / target));
+        connect(timer, &QTimer::timeout, this, &StreamVideoItem::requestFrame);
+        timer->start();
