 }
 
+void AppController::reportAutoLaunch(const QString &phase) const
+{
+    // The auto-launch clock itself lives in the home screen's QML, and this
+    // is the line that makes every one of its decisions greppable in the
+    // run's log: QML logs nothing in this application, and a clock that has
+    // not fired yet has no other trace, so an armed run that never launched
+    // would otherwise look identical to a run that was never armed. The
+    // observable end of a fired clock is a new session in native-streamer.log,
+    // and this says which of the two states the run was in.
+    qWarning() << "opennow-autolaunch:" << phase;
+}
