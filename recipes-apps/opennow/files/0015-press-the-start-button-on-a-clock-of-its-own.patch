--- a/opennow-qt/qml/desktop/home/DesktopHomeScreen.qml
+++ b/opennow-qt/qml/desktop/home/DesktopHomeScreen.qml
@@ -24,6 +24,61 @@
         onTriggered: root.lastPlayedNowMs = Date.now()
     }
 
+    // TEMPORARY, this era only: a clock for the Start button, so a session
+    // can be started without a pointer. The home screen's own button is
+    // Rectangle { id: startButton; ... TapHandler { id: startTap; onTapped:
+    // root.startHero() } }, and this Timer calls exactly what that tap calls:
+    // no launch path is added, and startHero keeps its own guards (it sets
+    // ShellStore.selectedGame to root.heroGame, the game the seat put first at
+    // start-up, and ShellStore.launchSelectedGame returns unless the run is
+    // signed in, the catalog is ready and no stream is already up). Started
+    // with --auto-launch-ms=<ms> the Timer presses that button <ms> ms after
+    // the home screen became active; with no flag autoLaunchMs is 0, the
+    // Timer never runs and the run is upstream's.
+    readonly property int autoLaunchMs: {
+        const arguments = Qt.application.arguments
+        for (let i = 0; i < arguments.length; ++i) {
+            if (arguments[i].indexOf("--auto-launch-ms") === 0) {
+                const parts = arguments[i].split("=")
+                if (parts.length === 2)
+                    return Math.max(1000, parseInt(parts[1], 10))
+            }
+        }
+        return 0
+    }
+    property int autoLaunchSeconds: 0
+    property bool autoLaunchFired: false
+
+    Timer {
+        id: autoLaunchClock
+        interval: 1000
+        repeat: true
+        running: root.autoLaunchMs > 0 && !root.autoLaunchFired
+            && root.visible && root.active && AppController.route === "home"
+            && Qt.application.state === Qt.ApplicationActive
+        triggeredOnStart: true
+        onTriggered: {
+            if (root.autoLaunchMs <= 0 || root.autoLaunchFired)
+                return
+            root.autoLaunchSeconds += 1
+            const waited = root.autoLaunchSeconds * 1000
+            if (waited < root.autoLaunchMs) {
+                AppController.reportAutoLaunch("waiting " + waited + "ms of "
+                    + root.autoLaunchMs + "ms, hero="
+                    + (root.heroGame ? String(root.heroGame.id) : "none"))
+                return
+            }
+            root.autoLaunchFired = true
+            if (!root.heroGame) {
+                AppController.reportAutoLaunch("no hero game to start")
+                return
+            }
+            AppController.reportAutoLaunch("pressing Start on "
+                + String(root.heroGame.title))
+            root.startHero()
+        }
+    }
+
     signal routeRequested(string route)
     signal gameRequested(var game)
     signal playRequested(var game)
