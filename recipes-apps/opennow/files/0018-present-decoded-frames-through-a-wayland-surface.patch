+/// A decoded frame handed to a compositor instead of converted on the GPU.
+///
+/// `fd` is a duplicate the receiver owns and closes; the remaining fields
+/// describe the DMA-BUF planes exactly as the kernel exported them, so a
+/// Wayland client can build a buffer without touching the pixels.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct DmabufExport {
+    pub fd: i32,
+    pub format: u32,
+    pub modifier: u64,
+    pub width: u32,
+    pub height: u32,
+    pub plane_count: u32,
+    pub plane_offset: [u32; 2],
+    pub plane_stride: [u32; 2],
+}
+
+impl Default for DmabufExport {
+    fn default() -> Self {
+        Self {
+            fd: -1,
+            format: 0,
+            modifier: 0,
+            width: 0,
+            height: 0,
+            plane_count: 0,
+            plane_offset: [0; 2],
+            plane_stride: [0; 2],
+        }
+    }
+}
+
+impl DmabufExport {
+    pub fn is_exported(&self) -> bool {
+        self.fd >= 0 && self.plane_count > 0
+    }
+}
