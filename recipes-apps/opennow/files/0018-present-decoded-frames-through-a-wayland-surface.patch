+target_include_directories(opennow-platform-video PUBLIC "${CMAKE_CURRENT_LIST_DIR}/../src")
+
+# The stream window needs a plain Wayland connection to the compositor Qt is
+# already using, plus the two protocols that turn the decoder's DMA-BUFs into
+# buffers: xdg-shell for the window and linux-dmabuf for the frame memory.
+enable_language(C)
+find_package(PkgConfig REQUIRED)
+pkg_check_modules(VIDEO_WAYLAND_CLIENT REQUIRED IMPORTED_TARGET wayland-client)
+pkg_check_modules(VIDEO_WAYLAND_PROTOCOLS REQUIRED wayland-protocols)
+pkg_get_variable(VIDEO_WAYLAND_PROTOCOLS_DIR wayland-protocols pkgdatadir)
+find_program(VIDEO_WAYLAND_SCANNER wayland-scanner REQUIRED)
+
+set(OPENNOW_VIDEO_PROTOCOL_DIR "${CMAKE_CURRENT_BINARY_DIR}/video-protocols")
+file(MAKE_DIRECTORY "${OPENNOW_VIDEO_PROTOCOL_DIR}")
+
+set(OPENNOW_VIDEO_PROTOCOLS
+    "xdg-shell|stable/xdg-shell/xdg-shell.xml"
+    "linux-dmabuf-unstable-v1|unstable/linux-dmabuf/linux-dmabuf-unstable-v1.xml")
+foreach(entry IN LISTS OPENNOW_VIDEO_PROTOCOLS)
+    string(REPLACE "|" ";" parts "${entry}")
+    list(GET parts 0 protocol_name)
+    list(GET parts 1 protocol_relative)
+    set(protocol_xml "${VIDEO_WAYLAND_PROTOCOLS_DIR}/${protocol_relative}")
+    set(protocol_header "${OPENNOW_VIDEO_PROTOCOL_DIR}/${protocol_name}-client-protocol.h")
+    set(protocol_code "${OPENNOW_VIDEO_PROTOCOL_DIR}/${protocol_name}-protocol.c")
+    add_custom_command(OUTPUT "${protocol_header}" "${protocol_code}"
+        COMMAND "${VIDEO_WAYLAND_SCANNER}" client-header "${protocol_xml}" "${protocol_header}"
+        COMMAND "${VIDEO_WAYLAND_SCANNER}" private-code "${protocol_xml}" "${protocol_code}"
+        DEPENDS "${protocol_xml}" VERBATIM)
+    target_sources(opennow-platform-video PRIVATE "${protocol_header}" "${protocol_code}")
+endforeach()
+target_include_directories(opennow-platform-video PRIVATE "${OPENNOW_VIDEO_PROTOCOL_DIR}")
+target_compile_definitions(opennow-platform-video PRIVATE OPENNOW_WAYLAND_VIDEO)
+target_link_libraries(opennow-platform-video PRIVATE PkgConfig::VIDEO_WAYLAND_CLIENT)
+message(STATUS "Wayland stream window enabled with xdg-shell and linux-dmabuf")
