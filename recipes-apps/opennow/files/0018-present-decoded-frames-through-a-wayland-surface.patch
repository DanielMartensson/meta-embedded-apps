diff --git a/opennow-qt/src/streaming/rendering/WaylandVideoSurface.cpp b/opennow-qt/src/streaming/rendering/WaylandVideoSurface.cpp
new file mode 100644
index 00000000..758cfd11
--- /dev/null
+++ b/opennow-qt/src/streaming/rendering/WaylandVideoSurface.cpp
@@ -0,0 +1,300 @@
+#include "streaming/rendering/WaylandVideoSurface.h"
+
+#include <QDebug>
+#include <QGuiApplication>
+#include <QMetaObject>
+#include <QtGui/qguiapplication_platform.h>
+
+#include <algorithm>
+#include <cstring>
+#include <ctime>
+#include <unistd.h>
+#include <wayland-client.h>
+
+#include "linux-dmabuf-unstable-v1-client-protocol.h"
+#include "xdg-shell-client-protocol.h"
+
+namespace {
+
+wl_display *qtWaylandDisplay()
+{
+    auto *native = qGuiApp
+        ? qGuiApp->nativeInterface<QNativeInterface::QWaylandApplication>() : nullptr;
+    return native ? native->display() : nullptr;
+}
+
+quint64 monotonicNs()
+{
+    timespec ts{};
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return quint64(ts.tv_sec) * 1'000'000'000ull + quint64(ts.tv_nsec);
+}
+
+}  // namespace
+
+WaylandVideoSurface::WaylandVideoSurface(QObject *parent)
+    : QObject(parent)
+{
+}
+
+WaylandVideoSurface::~WaylandVideoSurface()
+{
+    dismiss();
+    if (m_dmabuf) zwp_linux_dmabuf_v1_destroy(m_dmabuf);
+    if (m_shell) xdg_wm_base_destroy(m_shell);
+    if (m_compositor) wl_compositor_destroy(m_compositor);
+    if (m_registry) wl_registry_destroy(m_registry);
+    if (m_display) wl_display_flush(m_display);
+    m_dmabuf = nullptr;
+    m_shell = nullptr;
+    m_compositor = nullptr;
+    m_registry = nullptr;
+    m_display = nullptr;
+}
+
+WaylandVideoSurface *WaylandVideoSurface::instance()
+{
+    static WaylandVideoSurface *surface = nullptr;
+    if (!surface) surface = new WaylandVideoSurface();
+    return surface;
+}
+
+bool WaylandVideoSurface::environmentEnabled()
+{
+    static const bool enabled = qEnvironmentVariableIsSet("OPENNOW_WAYLAND_VIDEO");
+    return enabled;
+}
+
+void WaylandVideoSurface::handleGlobal(void *data, wl_registry *registry, quint32 name,
+                                       const char *interface, quint32 version)
+{
+    auto *self = static_cast<WaylandVideoSurface *>(data);
+    if (!self) return;
+    if (std::strcmp(interface, wl_compositor_interface.name) == 0) {
+        const quint32 bindVersion = std::min(version, 4u);
+        self->m_compositor = static_cast<wl_compositor *>(
+            wl_registry_bind(registry, name, &wl_compositor_interface, bindVersion));
+    } else if (std::strcmp(interface, xdg_wm_base_interface.name) == 0) {
+        self->m_shell = static_cast<xdg_wm_base *>(
+            wl_registry_bind(registry, name, &xdg_wm_base_interface, std::min(version, 2u)));
+        static const xdg_wm_base_listener shellListener = [] {
+            xdg_wm_base_listener listener{};
+            listener.ping = handlePing;
+            return listener;
+        }();
+        xdg_wm_base_add_listener(self->m_shell, &shellListener, self);
+    } else if (std::strcmp(interface, zwp_linux_dmabuf_v1_interface.name) == 0) {
+        self->m_dmabuf = static_cast<zwp_linux_dmabuf_v1 *>(
+            wl_registry_bind(registry, name, &zwp_linux_dmabuf_v1_interface,
+                             std::min(version, 3u)));
+    }
+}
+
+void WaylandVideoSurface::handleGlobalRemove(void *, wl_registry *, quint32)
+{
+}
+
+void WaylandVideoSurface::handlePing(void *, xdg_wm_base *shell, quint32 serial)
+{
+    xdg_wm_base_pong(shell, serial);
+}
+
+void WaylandVideoSurface::handleConfigure(void *data, xdg_surface *surface, quint32 serial)
+{
+    xdg_surface_ack_configure(surface, serial);
+    if (auto *self = static_cast<WaylandVideoSurface *>(data)) self->m_configured = true;
+}
+
+void WaylandVideoSurface::handleToplevelConfigure(void *, xdg_toplevel *, qint32, qint32,
+                                                  wl_array *)
+{
+}
+
+void WaylandVideoSurface::handleToplevelClose(void *data, xdg_toplevel *)
+{
+    // Closing the stream window must end the stream, not leave a black window
+    // covering the interface. The compositor sends this for its own close
+    // button and for anything else that asks the window to go away. The surface
+    // cannot be destroyed inside its own event dispatch, so defer it.
+    auto *self = static_cast<WaylandVideoSurface *>(data);
+    if (!self) return;
+    QMetaObject::invokeMethod(self, [self] { self->dismiss(); }, Qt::QueuedConnection);
+}
+
+void WaylandVideoSurface::handleBufferRelease(void *data, wl_buffer *buffer)
+{
+    Q_UNUSED(data);
+    wl_buffer_destroy(buffer);
+}
+
+bool WaylandVideoSurface::ensureSurface()
+{
+    if (m_surface) return true;
+    if (!m_display) m_display = qtWaylandDisplay();
+    if (!m_display) {
+        qWarning("wayland-video: Qt has no Wayland display, cannot create the stream window");
+        return false;
+    }
+    if (!m_registry) {
+        m_registry = wl_display_get_registry(m_display);
+        static const wl_registry_listener registryListener = [] {
+            wl_registry_listener listener{};
+            listener.global = handleGlobal;
+            listener.global_remove = handleGlobalRemove;
+            return listener;
+        }();
+        wl_registry_add_listener(m_registry, &registryListener, this);
+        wl_display_roundtrip(m_display);
+    }
+    if (!m_compositor || !m_shell) {
+        qWarning("wayland-video: compositor globals missing (compositor=%p shell=%p)",
+                 static_cast<void *>(m_compositor), static_cast<void *>(m_shell));
+        return false;
+    }
+
+    m_surface = wl_compositor_create_surface(m_compositor);
+    m_xdgSurface = xdg_wm_base_get_xdg_surface(m_shell, m_surface);
+    static const xdg_surface_listener surfaceListener = [] {
+        xdg_surface_listener listener{};
+        listener.configure = handleConfigure;
+        return listener;
+    }();
+    xdg_surface_add_listener(m_xdgSurface, &surfaceListener, this);
+    m_toplevel = xdg_surface_get_toplevel(m_xdgSurface);
+    static const xdg_toplevel_listener toplevelListener = [] {
+        xdg_toplevel_listener listener{};
+        listener.configure = handleToplevelConfigure;
+        listener.close = handleToplevelClose;
+        return listener;
+    }();
+    xdg_toplevel_add_listener(m_toplevel, &toplevelListener, this);
+    xdg_toplevel_set_app_id(m_toplevel, "opennow-video");
+    xdg_toplevel_set_title(m_toplevel, "OpenNOW stream");
+    xdg_toplevel_set_fullscreen(m_toplevel, nullptr);
+
+    // The Qt window underneath keeps the input focus: game input travels the
+    // path that already forwards it to the host, and this surface never eats a
+    // click meant for the interface.
+    if (wl_region *region = wl_compositor_create_region(m_compositor)) {
+        wl_surface_set_input_region(m_surface, region);
+        wl_region_destroy(region);
+    }
+    wl_surface_commit(m_surface);
+    wl_display_roundtrip(m_display);
+    if (!m_configured) {
+        qWarning("wayland-video: the compositor sent no configure event");
+        destroySurface();
+        return false;
+    }
+    qInfo("wayland-video: stream window created");
+    return true;
+}
+
+void WaylandVideoSurface::destroySurface()
+{
+    if (m_pendingBuffer) {
+        wl_buffer_destroy(m_pendingBuffer);
+        m_pendingBuffer = nullptr;
+    }
+    if (m_toplevel) xdg_toplevel_destroy(m_toplevel);
+    if (m_xdgSurface) xdg_surface_destroy(m_xdgSurface);
+    if (m_surface) wl_surface_destroy(m_surface);
+    m_toplevel = nullptr;
+    m_xdgSurface = nullptr;
+    m_surface = nullptr;
+    m_configured = false;
+    m_mapped = false;
+}
+
+bool WaylandVideoSurface::ensureDmabuf()
+{
+    return m_dmabuf != nullptr;
+}
+
+void WaylandVideoSurface::flushDisplay()
+{
+    if (m_display) wl_display_flush(m_display);
+}
+
+void WaylandVideoSurface::present(Frame frame)
+{
+    if (frame.fd >= 0 && frame.planeCount > 0 && frame.size.width() > 0
+            && frame.size.height() > 0) {
+        if (ensureSurface() && ensureDmabuf() && m_configured) {
+            attachFrame(frame);
+        } else {
+            ++m_dropped;
+        }
+    }
+    if (frame.fd >= 0) close(frame.fd);
+
+    const quint64 now = monotonicNs();
+    if (m_sampleStart == 0) {
+        m_sampleStart = now;
+        m_sampleCount = 0;
+    } else if (now - m_sampleStart >= 1'000'000'000ull) {
+        const double fps = double(m_sampleCount) * 1.0e9 / double(now - m_sampleStart);
+        m_sampleStart = now;
+        m_sampleCount = 0;
+        if (qEnvironmentVariableIsSet("OPENNOW_LOG_PRESENT"))
+            qInfo("wayland-video fps=%.1f committed=%llu dropped=%llu",
+                  fps, m_committed, m_dropped);
+    }
+}
+
+void WaylandVideoSurface::attachFrame(const Frame &frame)
+{
+    zwp_linux_buffer_params_v1 *params = zwp_linux_dmabuf_v1_create_params(m_dmabuf);
+    if (!params) {
+        ++m_dropped;
+        return;
+    }
+    const quint32 planes = std::min<quint32>(frame.planeCount, 2);
+    for (quint32 plane = 0; plane < planes; ++plane) {
+        zwp_linux_buffer_params_v1_add(params, frame.fd, int(plane), frame.offsets[plane],
+                                       frame.strides[plane],
+                                       quint32(frame.modifier >> 32),
+                                       quint32(frame.modifier & 0xffffffffu));
+    }
+    wl_buffer *buffer = zwp_linux_buffer_params_v1_create_immed(
+        params, quint32(frame.size.width()), quint32(frame.size.height()), frame.format, 0);
+    zwp_linux_buffer_params_v1_destroy(params);
+    if (!buffer) {
+        ++m_dropped;
+        return;
+    }
+    static const wl_buffer_listener bufferListener = [] {
+        wl_buffer_listener listener{};
+        listener.release = handleBufferRelease;
+        return listener;
+    }();
+    wl_buffer_add_listener(buffer, &bufferListener, this);
+
+    if (m_pendingBuffer) {
+        // The compositor already has the previous frame; this one replaces it.
+        wl_buffer_destroy(m_pendingBuffer);
+    }
+    m_pendingBuffer = buffer;
+    wl_surface_attach(m_surface, buffer, 0, 0);
+    if (wl_proxy_get_version(reinterpret_cast<wl_proxy *>(m_surface)) >= 4)
+        wl_surface_damage_buffer(m_surface, 0, 0, frame.size.width(), frame.size.height());
+    else
+        wl_surface_damage(m_surface, 0, 0, frame.size.width(), frame.size.height());
+    wl_surface_commit(m_surface);
+    flushDisplay();
+    m_mapped = true;
+    ++m_committed;
+    ++m_sampleCount;
+}
+
+void WaylandVideoSurface::dismiss()
+{
+    if (!m_surface) return;
+    wl_surface_attach(m_surface, nullptr, 0, 0);
+    wl_surface_commit(m_surface);
+    flushDisplay();
+    destroySurface();
+    m_committed = 0;
+    m_sampleStart = 0;
+    qInfo("wayland-video: stream window closed");
+}
diff --git a/opennow-qt/src/streaming/rendering/WaylandVideoSurface.h b/opennow-qt/src/streaming/rendering/WaylandVideoSurface.h
new file mode 100644
index 00000000..3472b7d6
--- /dev/null
+++ b/opennow-qt/src/streaming/rendering/WaylandVideoSurface.h
@@ -0,0 +1,87 @@
+#pragma once
+
+#include <QObject>
+#include <QSize>
+#include <cstdint>
+
+struct wl_array;
+struct wl_buffer;
+struct wl_compositor;
+struct wl_display;
+struct wl_registry;
+struct wl_surface;
+struct xdg_surface;
+struct xdg_toplevel;
+struct xdg_wm_base;
+struct zwp_linux_dmabuf_v1;
+
+// Presents decoded frames on a Wayland surface of its own instead of handing
+// them to the Qt scene graph. The decoder writes NV12 into a DMA-BUF that the
+// compositor can take straight to a plane, so nothing on the GPU has to convert
+// or copy a 1080p frame before it reaches the screen. The surface is created on
+// demand, ignores input (the Qt window underneath keeps receiving it) and is
+// torn down when the stream ends.
+class WaylandVideoSurface final : public QObject
+{
+    Q_OBJECT
+public:
+    struct Frame {
+        int fd = -1;
+        quint32 format = 0;
+        quint64 modifier = 0;
+        QSize size;
+        quint32 planeCount = 0;
+        quint32 offsets[2] = {0, 0};
+        quint32 strides[2] = {0, 0};
+    };
+
+    // One process-wide surface: the compositor connection comes from Qt, and a
+    // stream has exactly one video window.
+    static WaylandVideoSurface *instance();
+    static bool environmentEnabled();
+
+    // Takes ownership of frame.fd and closes it whatever happens.
+    void present(Frame frame);
+    void dismiss();
+
+    [[nodiscard]] bool isMapped() const { return m_mapped; }
+    [[nodiscard]] quint64 committed() const { return m_committed; }
+    [[nodiscard]] quint64 dropped() const { return m_dropped; }
+
+private:
+    explicit WaylandVideoSurface(QObject *parent = nullptr);
+    ~WaylandVideoSurface() override;
+
+    bool ensureSurface();
+    void destroySurface();
+    bool ensureDmabuf();
+    void attachFrame(const Frame &frame);
+    void flushDisplay();
+
+    static void handleGlobal(void *data, wl_registry *registry, quint32 name,
+                             const char *interface, quint32 version);
+    static void handleGlobalRemove(void *data, wl_registry *registry, quint32 name);
+    static void handlePing(void *data, xdg_wm_base *shell, quint32 serial);
+    static void handleConfigure(void *data, xdg_surface *surface, quint32 serial);
+    static void handleToplevelConfigure(void *data, xdg_toplevel *toplevel,
+                                       qint32 width, qint32 height, wl_array *states);
+    static void handleToplevelClose(void *data, xdg_toplevel *toplevel);
+    static void handleBufferRelease(void *data, wl_buffer *buffer);
+
+    wl_display *m_display = nullptr;
+    wl_registry *m_registry = nullptr;
+    wl_compositor *m_compositor = nullptr;
+    xdg_wm_base *m_shell = nullptr;
+    zwp_linux_dmabuf_v1 *m_dmabuf = nullptr;
+
+    wl_surface *m_surface = nullptr;
+    xdg_surface *m_xdgSurface = nullptr;
+    xdg_toplevel *m_toplevel = nullptr;
+    wl_buffer *m_pendingBuffer = nullptr;
+    bool m_configured = false;
+    bool m_mapped = false;
+    quint64 m_committed = 0;
+    quint64 m_dropped = 0;
+    quint64 m_sampleStart = 0;
+    quint64 m_sampleCount = 0;
+};
