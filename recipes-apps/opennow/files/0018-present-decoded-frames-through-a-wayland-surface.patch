+add_library(opennow-platform-video STATIC
+    "${CMAKE_CURRENT_LIST_DIR}/../src/streaming/rendering/WaylandVideoSurface.cpp"
+    "${CMAKE_CURRENT_LIST_DIR}/../src/streaming/rendering/WaylandVideoSurface.h")
