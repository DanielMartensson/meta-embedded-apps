+// The cloud game sits behind a pop-up until something answers it with an Enter,
+// and a session started while the board sits empty has nobody to press one, so
+// the window answers with an Enter of its own. OPENNOW_POPUP_ENTER_MS says how
+// long after the window became live the first press goes out; unset arms nothing.
+// OPENNOW_POPUP_ENTER_TIMES (4 when unset) repeats the press, and the press
+// travels the streamer's own key API, so it does not need the compositor to
+// hand the window the keyboard: it is the same Enter a physical key makes.
+void WaylandVideoSurface::armOpeningEnterClock()
+{
+    static const int armMs = [] {
+        const int parsed = qgetenv("OPENNOW_POPUP_ENTER_MS").toInt();
+        return parsed > 0 ? parsed : 0;
+    }();
+    static const int times = [] {
+        const int parsed = qgetenv("OPENNOW_POPUP_ENTER_TIMES").toInt();
+        return parsed > 0 ? parsed : 4;
+    }();
+    if (armMs <= 0) return;
+    m_enterLeft = times;
+    if (!m_enterTimer) {
+        m_enterTimer = new QTimer(this);
+        m_enterTimer->setTimerType(Qt::PreciseTimer);
+        connect(m_enterTimer, &QTimer::timeout, this, [this] { answerOpeningEnter(); });
+    }
+    // The first press waits for the cloud boot to reach the pop-up; the answers
+    // that follow are 5 s apart, so a boot that loads slower is answered as
+    // well. The clock runs at the arming distance first and the answer retimes
+    // it, because a QTimer keeps the interval it was started with.
+    m_enterTimer->setInterval(armMs);
+    m_enterTimer->start();
+    qInfo("wayland-video input: opening enter clock armed: %d ms then %d more at 5s",
+          armMs, m_enterLeft - 1);
+}
+
+void WaylandVideoSurface::answerOpeningEnter()
+{
+    if (m_enterLeft <= 0) {
+        if (m_enterTimer) m_enterTimer->stop();
+        return;
+    }
+    // Until the streamer is attached there is no key API to answer through, and
+    // the clock keeps its spacing rather than burning a press on nothing.
+    if (m_input.key) {
+        --m_enterLeft;
+        // Enter is VK_RETURN; a tap sends the press and the release together.
+        m_input.key(0x0d, 0, true);
+        m_input.key(0x0d, 0, false);
+        qInfo("wayland-video input: opening enter answered (%d left)", m_enterLeft);
+    }
+    if (!m_enterTimer) return;
+    m_enterTimer->stop();
+    if (m_enterLeft > 0) {
+        // The round that just fired was the arming distance, so the clock is
+        // retimed for the answers that follow and started again from the top.
+        m_enterTimer->setInterval(5'000);
+        m_enterTimer->start();
+    }
+}
+
 void WaylandVideoSurface::releaseHeldKeys()
 {
     m_f11Down = false;
@@ -821,6 +880,7 @@
     ensureSeatInput();
     updatePointerConstraint();
     qInfo("wayland-video: stream window created");
+    armOpeningEnterClock();
     return true;
 }
 
@@ -890,6 +950,12 @@
 {
     // The game must not be left with keys held down when the window goes away.
     releaseHeldKeys();
+    // A stream that ended has no pop-up left to answer, and a clock that keeps
+    // running would press Enter into whatever the next screen shows.
+    if (m_enterTimer) {
+        m_enterTimer->stop();
+        m_enterLeft = 0;
+    }
     // The constraint and the relative pointer both belong to the pointer, so
     // they have to go first.
     m_capturePointer = false;

