+/// FFmpeg's CUDA device tries to load libcuda.so.1 and logs an error when it is
+/// not there, which is the normal case on every board without an NVIDIA GPU.
+/// Ask the kernel first, so a missing driver is a plain "not available" instead
+/// of an error on the console.
+fn cuda_device_present() -> bool {
+    std::path::Path::new("/dev/nvidiactl").exists()
+}
