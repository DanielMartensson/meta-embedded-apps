@@ -238,6 +238,7 @@
     bool m_f11Down = false;
     QTimer *m_enterTimer = nullptr;
     int m_enterLeft = 0;
+    int m_enterHeldMs = 0;
     quint32 m_xkbModifiers = 0;
     bool m_pointerInside = false;
 

diff --git a/opennow-qt/src/streaming/rendering/WaylandVideoSurface.cpp b/opennow-qt/src/streaming/rendering/WaylandVideoSurface.cpp
