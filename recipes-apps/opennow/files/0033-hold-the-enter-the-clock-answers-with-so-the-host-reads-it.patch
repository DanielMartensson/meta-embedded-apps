@@ -538,6 +541,7 @@
     }();
     if (armMs <= 0) return;
     m_enterLeft = times;
+    m_enterHeldMs = 0;
     if (!m_enterTimer) {
         m_enterTimer = new QTimer(this);
         m_enterTimer->setTimerType(Qt::PreciseTimer);
@@ -555,27 +559,55 @@
 
 void WaylandVideoSurface::answerOpeningEnter()
 {
-    if (m_enterLeft <= 0) {
+    // What answers the pop-up has to be a press the cloud host can read, and a
+    // press has to stay down long enough to be read at all. A tap is not: the
+    // r0.60 run armed this clock and answered 12 times, 5.00-5.01 s apart,
+    // through the very hooks a player's own Enter uses, and the notice Steam
+    // puts in front of Destiny 2 stayed up; the same Enter pressed by a finger
+    // on this board held for 32 ms (wayland-video input: key 28 vk=0xd pressed=1
+    // at 11:15:46.301 and pressed=0 at .333) and closed it. So the clock presses
+    // on one round and releases on the next, which makes the hold the release's
+    // own interval. OPENNOW_POPUP_ENTER_HOLD_MS (120 ms when unset) says how long
+    // that press stays down.
+    static const int holdMs = [] {
+        const int parsed = qgetenv("OPENNOW_POPUP_ENTER_HOLD_MS").toInt();
+        return parsed > 0 ? parsed : 120;
+    }();
+    if (m_enterLeft <= 0 && m_enterHeldMs <= 0) {
         if (m_enterTimer) m_enterTimer->stop();
         return;
     }
+    if (m_enterHeldMs > 0) {
+        // The press is still down: answer with the release and put the clock back
+        // on the 5 s spacing the follow-up answers keep.
+        const int held = m_enterHeldMs;
+        m_enterHeldMs = 0;
+        if (m_input.key) m_input.key(0x0d, 0, false);
+        if (qEnvironmentVariableIsSet("OPENNOW_LOG_INPUT"))
+            qInfo("wayland-video input: opening enter held for %d ms and released", held);
+        if (!m_enterTimer) return;
+        if (m_enterLeft <= 0) {
+            m_enterTimer->stop();
+            return;
+        }
+        m_enterTimer->setInterval(5'000);
+        m_enterTimer->start();
+        return;
+    }
     // Until the streamer is attached there is no key API to answer through, and
     // the clock keeps its spacing rather than burning a press on nothing.
     if (m_input.key) {
         --m_enterLeft;
-        // Enter is VK_RETURN; a tap sends the press and the release together.
+        // Enter is VK_RETURN; the press goes out now and the release follows on
+        // the next round, holdMs later.
         m_input.key(0x0d, 0, true);
-        m_input.key(0x0d, 0, false);
+        m_enterHeldMs = holdMs;
         qInfo("wayland-video input: opening enter answered (%d left)", m_enterLeft);
     }
     if (!m_enterTimer) return;
     m_enterTimer->stop();
-    if (m_enterLeft > 0) {
-        // The round that just fired was the arming distance, so the clock is
-        // retimed for the answers that follow and started again from the top.
-        m_enterTimer->setInterval(5'000);
-        m_enterTimer->start();
-    }
+    m_enterTimer->setInterval(m_enterHeldMs > 0 ? holdMs : 5'000);
+    m_enterTimer->start();
 }
 
 void WaylandVideoSurface::releaseHeldKeys()
@@ -952,6 +984,9 @@
     releaseHeldKeys();
     // A stream that ended has no pop-up left to answer, and a clock that keeps
     // running would press Enter into whatever the next screen shows.
+    if (m_enterHeldMs > 0 && m_input.key)
+        m_input.key(0x0d, 0, false);
+    m_enterHeldMs = 0;
     if (m_enterTimer) {
         m_enterTimer->stop();
         m_enterLeft = 0;

