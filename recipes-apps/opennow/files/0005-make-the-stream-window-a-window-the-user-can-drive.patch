+
+void WaylandVideoSurface::setWindowed(bool windowed)
+{
+    if (!m_surface || !m_toplevel || m_windowed == windowed) return;
+    m_windowed = windowed;
+    if (windowed) {
+        // A decorated window the user can move and close: the close button is
+        // the compositor's, and closing it ends the stream.
+        xdg_toplevel_unset_fullscreen(m_toplevel);
+        if (m_viewport)
+            wp_viewport_set_destination(m_viewport, kWindowWidth, kWindowHeight);
+        wl_surface_set_input_region(m_surface, nullptr);
+    } else {
+        xdg_toplevel_set_fullscreen(m_toplevel, nullptr);
+        if (m_viewport) wp_viewport_set_destination(m_viewport, -1, -1);
+        if (wl_region *region = wl_compositor_create_region(m_compositor)) {
+            wl_surface_set_input_region(m_surface, region);
+            wl_region_destroy(region);
+        }
+    }
+    wl_surface_commit(m_surface);
+    flushDisplay();
+    qInfo("wayland-video: stream window %s", windowed ? "windowed" : "fullscreen");
+    emit windowedChanged();
+}
+
+void WaylandVideoSurface::setFramePuller(FramePuller puller)
+{
+    m_puller = std::move(puller);
+    if (!m_puller) {
+        if (m_pullTimer) m_pullTimer->stop();
+        return;
+    }
+    if (!m_pullTimer) {
+        m_pullTimer = new QTimer(this);
+        m_pullTimer->setTimerType(Qt::PreciseTimer);
+        // A little faster than the display: the newest frame wins, so a late
+        // timer never shows an old picture.
+        m_pullTimer->setInterval(8);
+        connect(m_pullTimer, &QTimer::timeout, this, [this] {
+            if (m_puller) m_puller();
+        });
+    }
+    if (!m_pullTimer->isActive()) {
+        m_pullTimer->start();
+        qInfo("wayland-video: frames are pulled from the interface thread");
+    }
+}
+
+void WaylandVideoSurface::simulateCloseForDevelopment()
+{
+    if (!m_mapped) return;
+    emit closeRequested();
+    dismiss();
+}
