+void WaylandVideoSurface::handleKeyboardKey(void *data, wl_keyboard *, quint32, quint32,
+                                            quint32 key, quint32 state)
+{
+    // In windowed mode the user clicks the stream window, the compositor gives
+    // it the keyboard and the interface would stop receiving F11. Hand that one
+    // shortcut over; everything else has no use here because the interface
+    // window is the one that forwards game input.
+    auto *self = static_cast<WaylandVideoSurface *>(data);
+    if (!self || key != 87 /* KEY_F11 */
+            || state != WL_KEYBOARD_KEY_STATE_PRESSED) {
+        return;
+    }
+    QMetaObject::invokeMethod(self, [self] { emit self->toggleRequested(); },
+                              Qt::QueuedConnection);
+}
+
+void WaylandVideoSurface::focusInterfaceWindow()
+{
+    QPointer<QWindow> window = m_appWindow;
+    if (!window) return;
+    // The compositor focuses a fresh toplevel while it maps it, so ask for the
+    // keyboard back once that has settled: without it the game would get no
+    // input at all.
+    QTimer::singleShot(150, window, [window] {
+        if (window) window->requestActivate();
+    });
 }
 
