@@ -555,6 +555,15 @@ impl DmaBufFrame {
                 rows,
             });
         }
+        if let Ok(path) = std::env::var("OPENNOW_DUMP_NV12") {
+            use std::sync::atomic::{AtomicBool, Ordering};
+            static DUMPED: AtomicBool = AtomicBool::new(false);
+            if !DUMPED.swap(true, Ordering::Relaxed) && planes.len() == 2 {
+                let _ = std::fs::write(format!("{path}.y"), planes[0].data.as_ref());
+                let _ = std::fs::write(format!("{path}.uv"), planes[1].data.as_ref());
+                eprintln!("opennow-diag: dumped NV12 {width}x{height} to {path}.y/.uv");
+            }
+        }
         Ok(planes)
     }
 
