 namespace {
 constexpr auto TeardownDeadline = std::chrono::seconds(10);
 
+#ifdef OPENNOW_WAYLAND_DECORATIONS
+// The VeriSilicon Vulkan driver opens its own connection to the compositor to
+// allocate buffers (wl_viv) and drops that connection when a swapchain goes
+// away, while its wl_compositor proxy is still attached. libwayland reports it
+// on every start and every exit:
+//
+//   warning: queue 0xffff... destroyed while proxies still attached:
+//     wl_compositor@35 still attached
+//
+// The queue belongs to a connection the driver made, so no client-side change
+// prevents it. Drop exactly that report and leave every other libwayland
+// diagnostic on stderr.
+bool g_suppressOrphanedQueueReport = false;
+
+void waylandLogHandler(const char *format, va_list arguments)
+{
+    char line[512];
+    const int length = std::vsnprintf(line, sizeof line, format, arguments);
+    if (length <= 0) return;
+    const auto text = std::string_view(line, std::min<size_t>(size_t(length), sizeof line - 1));
+    if (text.starts_with("warning: queue ")
+        && text.find("destroyed while proxies still attached") != std::string_view::npos) {
+        g_suppressOrphanedQueueReport = true;
+        return;
+    }
+    if (g_suppressOrphanedQueueReport && text.starts_with("  ")
+        && text.find("still attached") != std::string_view::npos) {
+        return;
+    }
+    g_suppressOrphanedQueueReport = false;
+    std::fwrite(line, 1, size_t(length), stderr);
+}
+#endif
+
