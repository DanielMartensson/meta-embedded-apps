+    /// Copies a linear NV12 DMA-BUF into tightly packed CPU planes.
+    ///
+    /// The presenter uses this when the graphics device cannot import the
+    /// decoder's DMA-BUF, for example a Vulkan driver without external memory
+    /// support. Decoding still runs on the hardware decoder; only the
+    /// presentation buffer is copied.
+    pub fn copy_nv12_planes(&self, width: u32, height: u32) -> Result<Vec<FramePlane>> {
+        self.validate()?;
+        let layer = self
+            .layers
+            .first()
+            .ok_or_else(|| Error::InvalidFormat("DMA-BUF frame has no layer".to_owned()))?;
+        if width == 0 || height == 0 || height % 2 != 0 || layer.planes.len() < 2 {
+            return Err(Error::InvalidFormat(
+                "NV12 CPU copy requires a non-zero even height and two planes".to_owned(),
+            ));
+        }
+        let mut mappings: Vec<Option<DmaBufMapping>> =
+            (0..self.objects.len()).map(|_| None).collect();
+        let mut planes = Vec::with_capacity(2);
+        for (index, plane) in layer.planes.iter().take(2).enumerate() {
+            let object = &self.objects[plane.object_index];
+            let rows = (height >> index) as usize;
+            let row_bytes = width as usize;
+            if plane.pitch < row_bytes {
+                return Err(Error::InvalidFormat(
+                    "DMA-BUF plane pitch is smaller than the frame width".to_owned(),
+                ));
+            }
+            let end = plane
+                .offset
+                .checked_add(
+                    plane
+                        .pitch
+                        .checked_mul(rows.saturating_sub(1))
+                        .ok_or_else(|| {
+                            Error::InvalidFormat("DMA-BUF plane size overflow".to_owned())
+                        })?,
+                )
+                .and_then(|value| value.checked_add(row_bytes))
+                .ok_or_else(|| Error::InvalidFormat("DMA-BUF plane size overflow".to_owned()))?;
+            if end > object.size {
+                return Err(Error::InvalidFormat(
+                    "DMA-BUF plane exceeds the object size".to_owned(),
+                ));
+            }
+            if mappings[plane.object_index].is_none() {
+                mappings[plane.object_index] = Some(DmaBufMapping::new(object.fd, object.size)?);
+            }
+            let mapping = mappings[plane.object_index]
+                .as_ref()
+                .expect("DMA-BUF object is mapped");
+            mapping.begin_read();
+            let mut data = vec![0u8; row_bytes * rows];
+            for row in 0..rows {
+                unsafe {
+                    std::ptr::copy_nonoverlapping(
+                        mapping.pointer.add(plane.offset + row * plane.pitch),
+                        data.as_mut_ptr().add(row * row_bytes),
+                        row_bytes,
+                    );
+                }
+            }
+            mapping.end_read();
+            planes.push(FramePlane {
+                data: Arc::from(data),
+                stride: row_bytes,
+                rows,
+            });
+        }
+        Ok(planes)
+    }
