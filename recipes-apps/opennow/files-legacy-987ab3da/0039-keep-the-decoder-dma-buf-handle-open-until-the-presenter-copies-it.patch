+/// How many compositor handoffs keep their decoder frame alive.
+///
+/// A compositor handoff exports a descriptor: the plane offsets, the strides
+/// and the dma-buf fds the decoder opened for them. The export owns its own
+/// `F_DUPFD_CLOEXEC` duplicate of the decoder's handle, and the presenter
+/// keeps that duplicate open until the flush which carries the descriptor
+/// succeeds, so the import does not need the decoder to hold the surface any
+/// longer than it already does. What the import does need is that the decoder
+/// keep recycling its capture pool: pinning a wide window of decoder frames
+/// exhausts that pool, the decoder then names a fresh DMA-BUF for every frame,
+/// the presenter's one compositor buffer per DMA-BUF object cache misses every
+/// frame and the compositor EGL-imports a new image instead of reusing a
+/// small set; the first import the driver refuses turns into a fatal protocol
+/// error which closes the stream window. One frame keeps the surface, and the
+/// fds it named, alive until the queued compositor import and this crate's
+/// CPU copy have read them. The window is a measured quantity, not an assumed
+/// one: `OPENNOW_HANDOFF_RETAINED=N` overrides the default for the A/B runs,
+/// clamped to 1..=24 so the decoder is never asked to hold more surfaces than
+/// it had before this change.
+const COMPOSITOR_HANDOFF_RETAINED: usize = 1;
+
+/// The handoff window in force: [`COMPOSITOR_HANDOFF_RETAINED`] unless
+/// `OPENNOW_HANDOFF_RETAINED=N` asks for another one for the measurement.
+fn compositor_handoff_retained() -> usize {
+    static WINDOW: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    *WINDOW.get_or_init(|| {
+        let requested = std::env::var("OPENNOW_HANDOFF_RETAINED")
+            .ok()
+            .and_then(|value| value.trim().parse::<usize>().ok());
+        requested.unwrap_or(COMPOSITOR_HANDOFF_RETAINED).clamp(1, 24)
+    })
+}
