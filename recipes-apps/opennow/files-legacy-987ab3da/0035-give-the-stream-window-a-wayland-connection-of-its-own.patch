+bool WaylandVideoSurface::ensureConnection()
 {
-    if (m_surface) return true;
-    if (!m_display) m_display = qtWaylandDisplay();
+    if (m_display) {
+        if (!m_connectionFailed) return true;
+        // The last connection died with the last stream. Everything bound to it
+        // died with it too, so the next stream starts from a fresh one instead
+        // of failing on a dead socket.
+        m_registry = nullptr;
+        m_compositor = nullptr;
+        m_shell = nullptr;
+        m_viewporter = nullptr;
+        m_dmabuf = nullptr;
+        m_seat = nullptr;
+        m_keyboard = nullptr;
+        m_pointer = nullptr;
+        m_pointerConstraints = nullptr;
+        m_relativePointerManager = nullptr;
+        m_relativePointer = nullptr;
+        m_lockedPointer = nullptr;
+        m_buffers.clear();
+        wl_display_disconnect(m_display);
+        m_display = nullptr;
+        m_connectionFailed = false;
+        m_configured = false;
+    }
+    // A connection of its own, not Qt's. Qt 6 dispatches its Wayland display on
+    // an event thread of its own, and libwayland allows one thread per queue:
+    // sharing the connection made the two of us dispatch the same events, which
+    // the VeriSilicon WSI saw as a second release fence for a buffer it was
+    // still using (the buffer_fenced_release assertion that ended the game) and
+    // which turned a frame descriptor closed after a failed flush into a fatal
+    // error for the whole application. Owning the connection also means the
+    // buffer-release events below are dispatched on this thread only, so the
+    // buffer cache has a single owner.
+    m_display = wl_display_connect(nullptr);
     if (!m_display) {
-        qWarning("wayland-video: Qt has no Wayland display, cannot create the stream window");
+        qWarning("wayland-video: no Wayland connection for the stream window");
         return false;
     }
-    if (!m_registry) {
-        m_registry = wl_display_get_registry(m_display);
-        static const wl_registry_listener registryListener = [] {
-            wl_registry_listener listener{};
-            listener.global = handleGlobal;
-            listener.global_remove = handleGlobalRemove;
-            return listener;
-        }();
-        wl_registry_add_listener(m_registry, &registryListener, this);
-        wl_display_roundtrip(m_display);
+    m_registry = wl_display_get_registry(m_display);
+    static const wl_registry_listener registryListener = [] {
+        wl_registry_listener listener{};
+        listener.global = handleGlobal;
+        listener.global_remove = handleGlobalRemove;
+        return listener;
+    }();
+    wl_registry_add_listener(m_registry, &registryListener, this);
+    // One round trip for the globals, a second for what binding them sends: the
+    // seat's capabilities and the DMA-BUF formats.
+    wl_display_roundtrip(m_display);
+    wl_display_roundtrip(m_display);
+    return true;
+}
+
+void WaylandVideoSurface::reportConnectionError()
+{
+    if (m_connectionFailed) return;
+    m_connectionFailed = true;
+    const int error = wl_display_get_error(m_display);
+    qWarning("wayland-video: the compositor connection failed: %s",
+             error ? std::strerror(error) : "unknown error");
+    QMetaObject::invokeMethod(this, [this] {
+        emit closeRequested();
+        dismiss();
+    }, Qt::QueuedConnection);
+}
+
+void WaylandVideoSurface::pumpEvents()
+{
+    if (!m_display || m_connectionFailed) return;
+    // Take whatever the compositor has sent without ever waiting for it: this
+    // runs from the frame clock on the interface thread. The buffer releases
+    // arrive here, so a frame can be presented again only after this ran.
+    while (wl_display_prepare_read(m_display) != 0) {
+        // Events are already queued: dispatch them, then try to take the read
+        // side again.
+        if (wl_display_dispatch_pending(m_display) < 0) {
+            reportConnectionError();
+            return;
+        }
     }
+    wl_display_flush(m_display);
+    pollfd descriptor{wl_display_get_fd(m_display), POLLIN, 0};
+    if (::poll(&descriptor, 1, 0) > 0 && (descriptor.revents & POLLIN))
+        wl_display_read_events(m_display);
+    else
+        wl_display_cancel_read(m_display);
+    if (wl_display_dispatch_pending(m_display) < 0 || wl_display_get_error(m_display) != 0)
+        reportConnectionError();
+}
+
+bool WaylandVideoSurface::ensureSurface()
+{
+    if (m_surface) return true;
+    if (!ensureConnection()) return false;
     if (!m_compositor || !m_shell) {
         qWarning("wayland-video: compositor globals missing (compositor=%p shell=%p)",
                  static_cast<void *>(m_compositor), static_cast<void *>(m_shell));
@@ -823,21 +892,30 @@ void WaylandVideoSurface::flushDisplay()
     const int error = errno;
     if (error != EAGAIN) {
         ++m_flushFailures;
-        // Qt's own event thread flushes the same connection, so a failing flush
-        // here does not stop the video; report the first one only, and count
-        // the rest in the rate line.
         if (m_flushFailures == 1 && qEnvironmentVariableIsSet("OPENNOW_LOG_PRESENT"))
             qWarning("wayland-video: flush failed: %s (display error %d)",
                      std::strerror(error), wl_display_get_error(m_display));
     }
-    // Never let a stuck socket pin descriptors without bound; a frame that is
-    // still queued after a few more is long gone by now.
-    while (m_deferredFds.size() > 8)
-        ::close(m_deferredFds.takeFirst());
+    // The descriptors are still named by requests libwayland has not written
+    // yet, so they must stay open; closing one here is what made a full socket
+    // a fatal error for the connection. A compositor that stays behind for
+    // seconds is gone, and the stream is over either way.
+    if (m_deferredFds.size() > 240) {
+        qWarning("wayland-video: the compositor stopped reading the stream");
+        m_connectionFailed = true;
+        closeDeferredFds();
+    }
 }
 
