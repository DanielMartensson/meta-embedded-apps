+void WaylandVideoSurface::handlePointerButton(void *data, wl_pointer *, quint32, quint32,
+                                              quint32 button, quint32 state)
+{
+    auto *self = static_cast<WaylandVideoSurface *>(data);
+    if (!self || !self->m_input.button) return;
+    quint8 wire = 0;
+    switch (button) {
+    case 0x110: wire = 1; break;  // BTN_LEFT
+    case 0x111: wire = 3; break;  // BTN_RIGHT
+    case 0x112: wire = 2; break;  // BTN_MIDDLE
+    case 0x113: wire = 4; break;  // BTN_SIDE
+    case 0x114: wire = 5; break;  // BTN_EXTRA
+    default: return;
+    }
+    const bool pressed = state == WL_POINTER_BUTTON_STATE_PRESSED;
+    self->m_input.button(wire, pressed);
+    if (qEnvironmentVariableIsSet("OPENNOW_LOG_INPUT"))
+        qInfo("wayland-video input: button %u pressed=%d", wire, pressed);
+}
+
+void WaylandVideoSurface::handlePointerAxis(void *data, wl_pointer *, quint32, quint32 axis,
+                                            wl_fixed_t value)
+{
+    auto *self = static_cast<WaylandVideoSurface *>(data);
+    if (!self || !self->m_input.wheel || axis != WL_POINTER_AXIS_VERTICAL_SCROLL) return;
+    // Wayland counts scroll steps downwards as positive; the host expects the
+    // Qt wheel delta, which is 120 units per notch and positive upwards.
+    const double steps = wl_fixed_to_double(value);
+    if (steps == 0.0) return;
+    const long units = std::lround(-steps * 12.0);
+    const auto delta = static_cast<qint16>(std::clamp(units, -32768L, 32767L));
+    self->m_input.wheel(delta);
+    if (qEnvironmentVariableIsSet("OPENNOW_LOG_INPUT"))
+        qInfo("wayland-video input: wheel %ld", units);
+}
