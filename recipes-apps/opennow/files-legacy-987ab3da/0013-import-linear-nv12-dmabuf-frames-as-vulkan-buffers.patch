+#[derive(Debug)]
+struct LinearLayout {
+    planes: [PlaneCopy; 2],
+    buffer_sizes: Vec<u64>,
+}
+
+impl LinearLayout {
+    fn new(frame: &DmaBufFrame, format: crate::StreamFormat) -> Result<Self> {
+        frame.validate()?;
+        format.validate()?;
+        if format.pixel_format != PixelFormat::Nv12
+            || format.color_transfer != crate::ColorTransfer::Sdr
+        {
+            return Err(invalid("only 8-bit SDR NV12 is supported"));
+        }
+        let [layer] = frame.layers.as_slice() else {
+            return Err(invalid("expected one NV12 layer"));
+        };
+        let [luma, chroma] = layer.planes.as_slice() else {
+            return Err(invalid("expected exactly two planes"));
+        };
+        let mut copies = Vec::with_capacity(2);
+        let mut buffer_sizes = vec![0u64; frame.objects.len()];
+        for (index, plane) in [luma, chroma].into_iter().enumerate() {
+            let object = &frame.objects[plane.object_index];
+            let rows = u64::from(format.height >> index);
+            let width = u64::from(format.width >> index);
+            let row_bytes = if index == 0 { width } else { width * 2 };
+            let pitch = u64::try_from(plane.pitch)
+                .map_err(|_| invalid("plane pitch overflow"))?;
+            if pitch < row_bytes {
+                return Err(invalid("plane pitch is smaller than the visible width"));
+            }
+            if index == 1 && pitch % 2 != 0 {
+                return Err(invalid("chroma pitch must be even"));
+            }
+            let start = u64::try_from(plane.offset)
+                .map_err(|_| invalid("plane offset overflow"))?;
+            let end = start
+                .checked_add(
+                    (rows - 1)
+                        .checked_mul(pitch)
+                        .ok_or_else(|| invalid("plane size overflow"))?,
+                )
+                .and_then(|size| size.checked_add(row_bytes))
+                .ok_or_else(|| invalid("plane size overflow"))?;
+            if end > object.size as u64 {
+                return Err(invalid("plane exceeds the DMA-BUF object size"));
+            }
+            buffer_sizes[plane.object_index] = buffer_sizes[plane.object_index].max(end);
+            copies.push(PlaneCopy {
+                object: plane.object_index,
+                regions: vec![
+                    vk::BufferImageCopy::default()
+                        .buffer_offset(start)
+                        .buffer_row_length((pitch >> index) as u32)
+                        .image_subresource(
+                            vk::ImageSubresourceLayers::default()
+                                .aspect_mask(vk::ImageAspectFlags::COLOR)
+                                .layer_count(1),
+                        )
+                        .image_offset(vk::Offset3D { x: 0, y: 0, z: 0 })
+                        .image_extent(vk::Extent3D {
+                            width: width as u32,
+                            height: rows as u32,
+                            depth: 1,
+                        }),
+                ],
+            });
+        }
+        Ok(Self {
+            planes: copies.try_into().expect("two planes"),
+            buffer_sizes,
+        })
+    }
+}
