+// True when a physical device exposes a Vulkan Video decode extension. The
+// embedded streamer's shared device exists to decode with Vulkan Video, so on a
+// board that decodes through V4L2 Request or VA-API the probe has nothing to
+// build and only reports that the expected feature is missing. Asking first
+// keeps a normal configuration from looking like a broken one.
+inline bool hasVulkanVideoDecode()
+{
+    QVulkanInstance instance;
+    setSupportedApiVersion(instance);
+    if (!instance.create()) return false;
+    auto *functions = instance.functions();
+    if (!functions) return false;
+    const QByteArrayList decodeExtensions = {
+        "VK_KHR_video_decode_h264", "VK_KHR_video_decode_h265", "VK_KHR_video_decode_av1"};
+    for (VkPhysicalDevice device : physicalDevicesOf(&instance)) {
+        uint32_t count = 0;
+        if (functions->vkEnumerateDeviceExtensionProperties(device, nullptr, &count, nullptr)
+                != VK_SUCCESS || count == 0)
+            continue;
+        QList<VkExtensionProperties> available(count);
+        if (functions->vkEnumerateDeviceExtensionProperties(device, nullptr, &count,
+                                                            available.data()) != VK_SUCCESS)
+            continue;
+        available.resize(count);
+        for (const auto &property : available) {
+            if (decodeExtensions.contains(QByteArray(property.extensionName)))
+                return true;
+        }
+    }
+    return false;
+}
