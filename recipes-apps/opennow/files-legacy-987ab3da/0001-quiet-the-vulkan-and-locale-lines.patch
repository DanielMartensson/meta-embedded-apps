diff --git a/opennow-qt/src/main.cpp b/opennow-qt/src/main.cpp
index a3d0bc68..8b790a70 100644
--- a/opennow-qt/src/main.cpp
+++ b/opennow-qt/src/main.cpp
@@ -1,6 +1,36 @@
 #include "app/ApplicationStartup.h"
 
+#include <clocale>
+#include <langinfo.h>
+#include <QDebug>
+
+// ---------------------------------------------------------------------------
+// A UTF-8 character type
+// ---------------------------------------------------------------------------
+//
+// Embedded sessions often start with LANG=C, and Qt then warns once per process
+// that it depends on a UTF-8 locale. Qt's text handling really does want UTF-8:
+// with an ASCII character type, paths and titles converted with
+// QString::fromLocal8Bit() come out mangled.
+//
+// Only LC_CTYPE is changed. Number, date and collation formats keep following
+// whatever the session asks for, and LANG is left alone, so the language used
+// for the interface and for search results does not change.
+static void preferUtf8CharacterType()
+{
+    if (setlocale(LC_CTYPE, "") == nullptr)
+        return;
+    const QByteArray codeset = nl_langinfo(CODESET);
+    if (codeset == "UTF-8")
+        return;
+    if (setlocale(LC_CTYPE, "en_US.UTF-8") == nullptr)
+        return;   // no UTF-8 locale in the image; nothing to switch to
+    qputenv("LC_CTYPE", "en_US.UTF-8");
+    qInfo("OpenNOW: character type was %s, using en_US.UTF-8", codeset.constData());
+}
+
 int main(int argc, char *argv[])
 {
+    preferUtf8CharacterType();
     return runApplication(argc, argv);
 }
