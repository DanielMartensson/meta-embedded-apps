@@ -290,8 +305,105 @@ void WaylandVideoSurface::handlePointerAxisDiscrete(void *, wl_pointer *, quint3
 {
 }
 
+void WaylandVideoSurface::handleRelativeMotion(void *data, zwp_relative_pointer_v1 *, quint32,
+                                               quint32, wl_fixed_t dx, wl_fixed_t dy,
+                                               wl_fixed_t, wl_fixed_t)
+{
+    auto *self = static_cast<WaylandVideoSurface *>(data);
+    // Only movement is taken while the pointer is actually held in place; the
+    // rest of the time the position keeps the host cursor where the user sees
+    // it, which is what menus are aimed with.
+    if (!self || !self->m_lockActive) return;
+    self->submitRelative(wl_fixed_to_double(dx), wl_fixed_to_double(dy));
+}
+
+void WaylandVideoSurface::handleLocked(void *data, zwp_locked_pointer_v1 *)
+{
+    auto *self = static_cast<WaylandVideoSurface *>(data);
+    if (!self) return;
+    self->m_lockActive = true;
+    self->m_relativeRest[0] = self->m_relativeRest[1] = 0.0;
+    if (qEnvironmentVariableIsSet("OPENNOW_LOG_INPUT"))
+        qInfo("wayland-video input: pointer locked to the stream window");
+}
+
+void WaylandVideoSurface::handleUnlocked(void *data, zwp_locked_pointer_v1 *lockedPointer)
+{
+    auto *self = static_cast<WaylandVideoSurface *>(data);
+    if (!self) return;
+    // The compositor took the pointer away, which it does when another window
+    // takes the focus. Drop the constraint and ask for a new one after this
+    // event has been dispatched, so the next entry is captured too.
+    self->m_lockedPointer = nullptr;
+    self->m_lockActive = false;
+    zwp_locked_pointer_v1_destroy(lockedPointer);
+    if (qEnvironmentVariableIsSet("OPENNOW_LOG_INPUT"))
+        qInfo("wayland-video input: pointer lock released by the compositor");
+    QMetaObject::invokeMethod(self, [self] { self->updatePointerConstraint(); },
+                              Qt::QueuedConnection);
+}
+
+void WaylandVideoSurface::updatePointerConstraint()
+{
+    // Fullscreen is the playing mode: the frame fills the screen, so where the
+    // pointer sits carries nothing the host needs. The pointer is locked to the
+    // window instead and only the movement travels, which is what a game that
+    // turns with the mouse reads - an absolute position stops at the edge of
+    // the screen, and so does the turn. The windowed form exists to reach the
+    // interface, so the pointer stays free and absolute there.
+    const bool wanted = m_surface && m_pointer && !m_windowed;
+    m_capturePointer = wanted;
+    if (!wanted) {
+        if (m_lockedPointer) {
+            zwp_locked_pointer_v1_destroy(m_lockedPointer);
+            m_lockedPointer = nullptr;
+        }
+        m_relativeRest[0] = m_relativeRest[1] = 0.0;
+        m_lockActive = false;
+        return;
+    }
+    if (m_lockedPointer || !m_pointerConstraints || !m_pointerInside) return;
+    m_lockedPointer = zwp_pointer_constraints_v1_lock_pointer(
+        m_pointerConstraints, m_surface, m_pointer, nullptr,
+        ZWP_POINTER_CONSTRAINTS_V1_LIFETIME_ONESHOT);
+    static const zwp_locked_pointer_v1_listener lockedListener = [] {
+        zwp_locked_pointer_v1_listener listener{};
+        listener.locked = handleLocked;
+        listener.unlocked = handleUnlocked;
+        return listener;
+    }();
+    zwp_locked_pointer_v1_add_listener(m_lockedPointer, &lockedListener, this);
+    flushDisplay();
+}
+
+void WaylandVideoSurface::submitRelative(double dx, double dy)
+{
+    if (!m_input.relative) return;
+    // Wayland counts surface units, and in fullscreen the surface is the frame
+    // at its own size, so the host receives movement in its own pixels. The
+    // fraction is carried over rather than rounded away: a slow turn arrives in
+    // pieces smaller than a pixel.
+    m_relativeRest[0] += dx;
+    m_relativeRest[1] += dy;
+    const int wholeX = int(m_relativeRest[0]);
+    const int wholeY = int(m_relativeRest[1]);
+    if (wholeX == 0 && wholeY == 0) return;
+    m_relativeRest[0] -= wholeX;
+    m_relativeRest[1] -= wholeY;
+    m_input.relative(wholeX, wholeY);
+    static quint64 lastLog = 0;
+    const quint64 now = monotonicNs();
+    if (qEnvironmentVariableIsSet("OPENNOW_LOG_INPUT") && now - lastLog > 500'000'000ull) {
+        lastLog = now;
+        qInfo("wayland-video input: relative %dx%d", wholeX, wholeY);
+    }
+}
+
 void WaylandVideoSurface::submitPointer(double x, double y)
 {
+    // A locked pointer carries no position worth sending; its movement goes
+    // through submitRelative instead.
+    if (m_lockActive) return;
     if (!m_input.absolute || !m_videoSize.isValid()) return;
     // The surface carries the whole frame: unscaled when it is fullscreen, at
     // the window's destination size when it is windowed. The host gets the
@@ -582,6 +694,21 @@ bool WaylandVideoSurface::ensureSurface()
         }();
         wl_pointer_add_listener(m_pointer, &pointerListener, this);
     }
+    if (m_pointer && !m_relativePointer && m_relativePointerManager) {
+        // Raw movement is a different stream from the position: a game that
+        // looks with the mouse needs the deltas, and they keep coming while
+        // the pointer itself is locked in place.
+        m_relativePointer =
+            zwp_relative_pointer_manager_v1_get_relative_pointer(m_relativePointerManager,
+                                                                 m_pointer);
+        static const zwp_relative_pointer_v1_listener relativeListener = [] {
+            zwp_relative_pointer_v1_listener listener{};
+            listener.relative_motion = handleRelativeMotion;
+            return listener;
+        }();
+        zwp_relative_pointer_v1_add_listener(m_relativePointer, &relativeListener, this);
+    }
+    updatePointerConstraint();
     qInfo("wayland-video: stream window created");
     return true;
 }
@@ -590,6 +717,18 @@ void WaylandVideoSurface::destroySurface()
 {
     // The game must not be left with keys held down when the window goes away.
     releaseHeldKeys();
+    // The constraint and the relative pointer both belong to the pointer, so
+    // they have to go first.
+    m_capturePointer = false;
+    m_lockActive = false;
+    if (m_lockedPointer) {
+        zwp_locked_pointer_v1_destroy(m_lockedPointer);
+        m_lockedPointer = nullptr;
+    }
+    if (m_relativePointer) {
+        zwp_relative_pointer_v1_destroy(m_relativePointer);
+        m_relativePointer = nullptr;
+    }
     if (m_pointer) {
         wl_pointer_release(m_pointer);
         m_pointer = nullptr;
@@ -826,6 +965,7 @@ void WaylandVideoSurface::setWindowed(bool windowed)
         wl_surface_set_input_region(m_surface, nullptr);
     }
     wl_surface_commit(m_surface);
+    updatePointerConstraint();
     flushDisplay();
     qInfo("wayland-video: stream window %s", windowed ? "windowed" : "fullscreen");
     emit windowedChanged();
