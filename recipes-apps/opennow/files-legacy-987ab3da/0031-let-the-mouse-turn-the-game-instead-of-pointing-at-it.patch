+++ b/opennow-qt/src/streaming/rendering/NativeStreamRenderCallback.cpp
@@ -43,6 +43,16 @@ void submitVideoInputAbsolute(int x, int y, int width, int height)
         static_cast<std::uint16_t>(qBound(1, height, 65535)));
 }
 
+void submitVideoInputRelative(int dx, int dy)
+{
+    if (!videoInputRuntime) return;
+    // The host takes a 16-bit step, and a compositor can report a jump larger
+    // than that when the pointer is locked and the mouse flies.
+    videoInputRuntime->submitMouseRelative(
+        static_cast<qint16>(qBound(-32768, dx, 32767)),
+        static_cast<qint16>(qBound(-32768, dy, 32767)));
+}
+
 void submitVideoInputButton(quint8 button, bool pressed)
 {
     if (videoInputRuntime) videoInputRuntime->submitMouseButton(button, pressed);
@@ -62,6 +72,7 @@ WaylandVideoSurface::InputHooks videoInputHooks()
 {
     WaylandVideoSurface::InputHooks hooks;
     hooks.absolute = submitVideoInputAbsolute;
+    hooks.relative = submitVideoInputRelative;
     hooks.button = submitVideoInputButton;
     hooks.wheel = submitVideoInputWheel;
     hooks.key = submitVideoInputKey;
