--- a/native/opennow-streamer/crates/opennow-streamer-platform/src/embedded_input.rs
+++ b/native/opennow-streamer/crates/opennow-streamer-platform/src/embedded_input.rs
@@ -1,9 +1,79 @@
 use std::sync::Arc;
 use std::sync::Mutex;
-use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
 
 use crate::{CapturedInput, CapturedInputQueue, MouseSettings};
 
+// What the embedder actually handed the queue, and whether the queue's owner
+// was allowed to take it. The window reports its own presses (a key line per
+// transition, and 0 submit refusals because submit returns nothing), and the
+// drain reports what it forwarded; nothing in between says whether the event
+// ever entered the queue or which queue it entered. These counters close both
+// halves of that gap and name the queue by address so the drain's own line can
+// be put next to them.
+const EMBEDDED_INPUT_LOG_EVERY: usize = 24;
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum EmbeddedInputKind {
+    Key,
+    Move,
+    Absolute,
+    Button,
+    Other,
+}
+
+fn embedded_input_kind(input: &CapturedInput) -> EmbeddedInputKind {
+    match input {
+        CapturedInput::Key { .. } => EmbeddedInputKind::Key,
+        CapturedInput::MouseMove { .. } => EmbeddedInputKind::Move,
+        CapturedInput::MouseAbsolute { .. } => EmbeddedInputKind::Absolute,
+        CapturedInput::MouseButton { .. } => EmbeddedInputKind::Button,
+        _ => EmbeddedInputKind::Other,
+    }
+}
+
+fn embedded_input_tally(
+    kind: EmbeddedInputKind,
+    queue: Arc<CapturedInputQueue>,
+    active: bool,
+) {
+    static KEYS: AtomicUsize = AtomicUsize::new(0);
+    static MOVES: AtomicUsize = AtomicUsize::new(0);
+    static ABSOLUTES: AtomicUsize = AtomicUsize::new(0);
+    static BUTTONS: AtomicUsize = AtomicUsize::new(0);
+    static OTHER: AtomicUsize = AtomicUsize::new(0);
+    static PUSHED: AtomicUsize = AtomicUsize::new(0);
+    static DROPPED: AtomicUsize = AtomicUsize::new(0);
+
+    match kind {
+        EmbeddedInputKind::Key => KEYS.fetch_add(1, Ordering::Relaxed),
+        EmbeddedInputKind::Move => MOVES.fetch_add(1, Ordering::Relaxed),
+        EmbeddedInputKind::Absolute => ABSOLUTES.fetch_add(1, Ordering::Relaxed),
+        EmbeddedInputKind::Button => BUTTONS.fetch_add(1, Ordering::Relaxed),
+        _ => OTHER.fetch_add(1, Ordering::Relaxed),
+    };
+    let counted =
+        if active {
+            PUSHED.fetch_add(1, Ordering::Relaxed) + 1
+        } else {
+            DROPPED.fetch_add(1, Ordering::Relaxed) + 1
+        };
+    if counted == 1 || counted % EMBEDDED_INPUT_LOG_EVERY == 0 {
+        eprintln!(
+            "NVST embedded input tally: active={} pushed={} dropped={} keys={} moves={} absolutes={} buttons={} other={} queue={:p}",
+            active,
+            PUSHED.load(Ordering::Relaxed),
+            DROPPED.load(Ordering::Relaxed),
+            KEYS.load(Ordering::Relaxed),
+            MOVES.load(Ordering::Relaxed),
+            ABSOLUTES.load(Ordering::Relaxed),
+            BUTTONS.load(Ordering::Relaxed),
+            OTHER.load(Ordering::Relaxed),
+            queue,
+        );
+    }
+}
+
 #[derive(Debug, Clone, Copy, PartialEq, Eq)]
 pub enum EmbeddedLocalAction {
     Guide,
@@ -73,8 +143,12 @@
                 return;
             }
         }
+        let kind = embedded_input_kind(&input);
         if self.active.load(Ordering::Acquire) {
             self.queue.push(input);
+            embedded_input_tally(kind, Arc::clone(&self.queue), true);
+        } else {
+            embedded_input_tally(kind, Arc::clone(&self.queue), false);
         }
     }
 
