From 7d8e9f0a1b2c3d4e5f60718293a4b5c6d7e8f90a Mon Sep 17 00:00:00 2001
From: noname <noname@example.com>
Date: Tue, 3 Nov 2026 18:30:00 +0000
Subject: [PATCH] 0035 take a picture of the stream when asked for one

Every measurement in this series has one blind spot: the counters say what the
app sent, and only the TV says what the cloud host did with it. The stream
window takes the seat's keyboard and forwards every key to the host, so the
Ctrl+F11 screenshot shortcut cannot be pressed from the board while a stream is
up - it goes to the game. That is why the r0.60 and r0.61 runs can show 24 held
Enters leaving the app and cannot show whether Steam's notice went away.

This arms the same screenshot path the shortcut uses from an environment
variable instead: OPENNOW_STREAM_SCREENSHOT_MS is the interval in milliseconds
(0 or unset arms nothing, which leaves every earlier series' run unchanged) and
OPENNOW_STREAM_SCREENSHOT_TIMES is how many pictures to keep (4 when unset). It
goes through AppController::captureStreamScreenshot and
NativeStreamRuntime::requestScreenshot, the pair Ctrl+F11 already drives, so the
picture is the streamer's own decoded frame rather than a compositor grab, and
it is written where the shortcut writes, under Pictures/OpenNOW/Screenshots. A
tick while the stream is not presenting is refused and costs nothing, so the
first picture lands once the host has painted. Both ends are greppable:
`opennow-stream-screenshot: armed every %d ms, %d times` and
`opennow-stream-screenshot: saved %s`.

Upstream-Status: Inappropriate [STM32MP25 performance work]

diff --git a/opennow-qt/src/app/ApplicationStartup.cpp b/opennow-qt/src/app/ApplicationStartup.cpp
--- a/opennow-qt/src/app/ApplicationStartup.cpp
+++ b/opennow-qt/src/app/ApplicationStartup.cpp
@@ -49,6 +49,7 @@
 #include <cstdarg>
 #include <cstdio>
 #include <cstdlib>
+#include <memory>
 #include <string_view>
 #include <thread>
 
@@ -358,6 +359,35 @@
     });
     QObject::connect(&nativeStreamRuntime, &NativeStreamRuntime::screenshotReady,
                      &controller, &AppController::saveStreamScreenshot);
+    // A picture of the screen is the only witness to what the cloud host put on
+    // it, and while the stream window is up it takes the seat's keyboard, so the
+    // Ctrl+F11 shortcut cannot be pressed from the board. This clock takes the
+    // same screenshot the shortcut does, from the streamer's own frame, and it is
+    // armed only when asked for: OPENNOW_STREAM_SCREENSHOT_MS is the interval in
+    // milliseconds (0 or unset arms nothing) and OPENNOW_STREAM_SCREENSHOT_TIMES
+    // is how many to keep (4 when unset). A refused request - the stream not
+    // presenting yet - costs nothing and is retried on the next tick, which is
+    // what makes the first picture land once the cloud host has painted.
+    if (const int interval = qEnvironmentVariableIntValue("OPENNOW_STREAM_SCREENSHOT_MS");
+        interval > 0) {
+        bool wantedSet = false;
+        const int wantedValue = qEnvironmentVariableIntValue("OPENNOW_STREAM_SCREENSHOT_TIMES",
+                                                             &wantedSet);
+        const int wanted = wantedSet && wantedValue > 0 ? wantedValue : 4;
+        auto *clock = new QTimer(&controller);
+        auto saved = std::make_shared<int>(0);
+        QObject::connect(clock, &QTimer::timeout, &controller, [&controller] {
+            controller.captureStreamScreenshot(u"stream"_s);
+        });
+        QObject::connect(&controller, &AppController::streamScreenshotSaved, clock,
+                         [clock, saved, wanted](const QString &path) {
+                             if (path.isEmpty()) return;
+                             qInfo("opennow-stream-screenshot: saved %s", qUtf8Printable(path));
+                             if (++*saved >= wanted) clock->stop();
+                         });
+        qInfo("opennow-stream-screenshot: armed every %d ms, %d times", interval, wanted);
+        clock->start(interval);
+    }
     QObject::connect(&nativeStreamRuntime, &NativeStreamRuntime::controllerRumbleRequested,
                      &controllerInput, &ControllerInput::playRumble);
     QObject::connect(&nativeStreamRuntime, &NativeStreamRuntime::controllerRumbleStopped,

